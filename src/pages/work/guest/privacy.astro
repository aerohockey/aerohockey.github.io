---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuestPrivacyView from '../../../components/GuestPrivacyView.astro';
import {
  getGuestPrivacy,
  getProjectBySlug,
  getSiteSettings,
} from '../../../lib/content';

const [guest, privacy, settings] = await Promise.all([
  getProjectBySlug('guest'),
  getGuestPrivacy(),
  getSiteSettings(),
]);
---

<BaseLayout
  title={`${privacy.title.en} — ${settings.brand.en}`}
  description={privacy.intro.en}
  lang="en"
  activeNav="work"
  desktopLockViewport={false}
  ogImage={guest?.cover}
>
  <GuestPrivacyView lang="en" />
</BaseLayout>
