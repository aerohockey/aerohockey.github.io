---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfoView from '../components/InfoView.astro';
import { getSiteSettings } from '../lib/content';

const settings = await getSiteSettings();
---

<BaseLayout
  title={settings.aboutTitle.en}
  description={settings.aboutDescription.en}
  lang="en"
  activeNav="info"
  desktopLockViewport={false}
>
  <InfoView lang="en" />
</BaseLayout>
