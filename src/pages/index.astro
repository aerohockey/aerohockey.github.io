---
import BaseLayout from '../layouts/BaseLayout.astro';
import HorizontalWorkShowcase from '../components/HorizontalWorkShowcase.astro';
import { getSiteSettings } from '../lib/content';

const settings = await getSiteSettings();
---

<BaseLayout
  title={settings.homeTitle.en}
  description={settings.homeDescription.en}
  lang="en"
  activeNav="work"
  desktopLockViewport={true}
>
  <HorizontalWorkShowcase lang="en" />
</BaseLayout>
