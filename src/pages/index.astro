---
import BaseLayout from '../layouts/BaseLayout.astro';
import HorizontalWorkShowcase from '../components/HorizontalWorkShowcase.astro';
import { PROJECTS } from '../data/projects';

const total = String(PROJECTS.length).padStart(2, '0');
---

<BaseLayout
  title="Evgeny Ivanov — Art Director with a Camera"
  description="Art director with a camera — digital products, photography & visual direction."
  lang="en"
  activeNav="work"
  counterText={`01 / ${total}`}
  lockViewport={true}
  showFooterProgress={true}
>
  <HorizontalWorkShowcase lang="en" />
</BaseLayout>
