---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoView from '../../components/InfoView.astro';
import { getSiteSettings } from '../../lib/content';

const settings = await getSiteSettings();
---

<BaseLayout
  title={settings.aboutTitle.ru}
  description={settings.aboutDescription.ru}
  lang="ru"
  activeNav="info"
  desktopLockViewport={false}
>
  <InfoView lang="ru" />
</BaseLayout>
