---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import GuestPrivacyView from '../../../../components/GuestPrivacyView.astro';
import {
  getGuestPrivacy,
  getProjectBySlug,
  getSiteSettings,
} from '../../../../lib/content';

const [guest, privacy, settings] = await Promise.all([
  getProjectBySlug('guest'),
  getGuestPrivacy(),
  getSiteSettings(),
]);
---

<BaseLayout
  title={`${privacy.title.ru} — ${settings.brand.ru}`}
  description={privacy.intro.ru}
  lang="ru"
  activeNav="work"
  desktopLockViewport={false}
  ogImage={guest?.cover}
>
  <GuestPrivacyView lang="ru" />
</BaseLayout>
