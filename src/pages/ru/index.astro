---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HorizontalWorkShowcase from '../../components/HorizontalWorkShowcase.astro';
import { getSiteSettings } from '../../lib/content';

const settings = await getSiteSettings();
---

<BaseLayout
  title={settings.homeTitle.ru}
  description={settings.homeDescription.ru}
  lang="ru"
  activeNav="work"
  desktopLockViewport={true}
>
  <HorizontalWorkShowcase lang="ru" />
</BaseLayout>
