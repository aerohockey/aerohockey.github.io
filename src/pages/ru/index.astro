---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HorizontalWorkShowcase from '../../components/HorizontalWorkShowcase.astro';
import { PROJECTS } from '../../data/projects';

const total = String(PROJECTS.length).padStart(2, '0');
---

<BaseLayout
  title="Евгений Иванов — Арт-директор с камерой"
  description="Арт-директор с камерой — цифровые продукты, фотография и визуальные стратегии."
  lang="ru"
  activeNav="work"
  counterText={`01 / ${total}`}
  lockViewport={true}
>
  <HorizontalWorkShowcase lang="ru" />
</BaseLayout>
