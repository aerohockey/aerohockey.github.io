---
import { Image } from 'astro:assets';
import { PROJECTS, type CoverAspect } from '../data/projects';
import { getProjectPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const COVER_ASPECT_RATIOS: Record<CoverAspect, number> = {
  '3/4': 0.75,
  '4/5': 0.8,
  '1/1': 1,
  '5/4': 1.25,
  '4/3': 1.3333,
  '3/2': 1.5,
};

const ASPECT_RATIO_CLASSES: Record<CoverAspect, string> = {
  '3/4': 'aspect-[3/4]',
  '4/5': 'aspect-[4/5]',
  '1/1': 'aspect-square',
  '5/4': 'aspect-[5/4]',
  '4/3': 'aspect-[4/3]',
  '3/2': 'aspect-[3/2]',
};
---

<main class="flex-1 min-h-0 relative overflow-hidden pt-[72px] md:pt-16 pb-[calc(0.875rem+env(safe-area-inset-bottom))] md:pb-10">
  <div
    data-horizontal-track
    class="no-scrollbar h-full w-full overflow-x-auto overflow-y-hidden snap-x snap-mandatory md:snap-none scroll-pl-3.5 sm:scroll-pl-6 md:scroll-pl-0 flex items-end cursor-grab"
  >
    <div class="showcase-rail shrink-0 flex items-start gap-3.5 sm:gap-5 md:gap-6 lg:gap-8 px-3.5 sm:px-6 md:px-10">
      {PROJECTS.map((project, index) => {
        const href = getProjectPath(lang, project.slug);
        return (
          <article
            style={`--r: ${COVER_ASPECT_RATIOS[project.coverAspect]};`}
            class="showcase-card shrink-0 snap-start snap-always md:snap-align-none flex flex-col"
          >
            <a href={href} class="group flex flex-col w-full focus:outline-none">
              <div class="mb-3 text-[14px] md:text-[15px] leading-[1.3]">
                <h2 class="text-[#141414] font-medium">
                  {project.title[lang]}
                </h2>
                <p class="mt-0.5 text-[12px] md:text-[13px] leading-[1.35] tracking-[0.01em] text-[#141414]">
                  {project.subtitle[lang]}
                </p>
              </div>

              <div
                class:list={[
                  'w-full overflow-hidden bg-[#f5f5f3]',
                  ASPECT_RATIO_CLASSES[project.coverAspect],
                ]}
              >
                <Image
                  src={project.cover}
                  alt={project.coverAlt[lang]}
                  width={1400}
                  class="w-full h-full object-cover transition-opacity duration-500 ease-out group-hover:opacity-80 pointer-events-none select-none"
                  loading={index < 3 ? 'eager' : 'lazy'}
                  draggable={false}
                />
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </div>
</main>

<script>
  import { initHorizontalTrack } from '../scripts/horizontalScroll';
  initHorizontalTrack();
</script>

<style>
  .showcase-rail {
    --rail-h: min(calc((100vw - 48px) * 4 / 3), var(--rail-vh));
    min-height: calc(var(--rail-h) + 48.5px);
  }

  .showcase-card {
    width: calc(100vw - 48px);
    width: min(calc(100vw - 48px), calc(var(--rail-h) * var(--r)));
  }

  @media (min-width: 640px) {
    .showcase-rail {
      --rail-h: min(calc((100vw - 72px) * 4 / 3), var(--rail-vh));
    }

    .showcase-card {
      width: calc(100vw - 72px);
      width: min(calc(100vw - 72px), calc(var(--rail-h) * var(--r)));
    }
  }

  @media (min-width: 768px) {
    .showcase-rail {
      --rail-h: min(calc(40vw * 5 / 4), var(--rail-svh));
      min-height: 0;
    }

    .showcase-card {
      width: 40vw;
      width: min(40vw, calc(var(--rail-h) * var(--r)));
    }
  }

  @media (min-width: 1024px) {
    .showcase-rail {
      --rail-h: min(calc(33vw * 5 / 4), 625px, var(--rail-svh));
    }

    .showcase-card {
      width: min(33vw, 500px);
      width: min(33vw, 500px, calc(var(--rail-h) * var(--r)));
    }
  }
</style>
