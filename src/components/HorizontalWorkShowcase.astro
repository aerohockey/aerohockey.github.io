---
import { Image } from 'astro:assets';
import { PROJECTS, type CoverAspect } from '../data/projects';
import { UI, getProjectPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];

const COVER_ASPECT_RATIOS: Record<CoverAspect, number> = {
  '3/4': 0.75,
  '4/5': 0.8,
  '1/1': 1,
  '5/4': 1.25,
  '4/3': 1.3333,
  '3/2': 1.5,
  '16/9': 1.7778,
};
---

<main class="flex-1 min-h-0 flex flex-col pt-[96px] md:pt-[58px] pb-[calc(1.25rem+env(safe-area-inset-bottom))] md:pb-10 md:overflow-hidden text-[14px] md:text-[13px] 2xl:text-[15px] leading-[1.35] font-normal text-[#141414]">
  <!-- Quiet positioning statement -->
  <div class="px-4 sm:px-6 md:px-10 shrink-0 mb-14 md:mb-6">
    <h1 class="max-w-[340px] sm:max-w-[400px] md:max-w-[420px] leading-[1.45]">
      {t.homeStatement}
    </h1>
  </div>

  <!-- Horizontal shelf: top-aligned right under statement on mobile, bottom-anchored on desktop -->
  <div
    data-horizontal-track
    class="no-scrollbar md:flex-1 md:min-h-0 w-full overflow-x-auto overflow-y-hidden snap-x snap-mandatory md:snap-none scroll-pl-4 sm:scroll-pl-6 md:scroll-pl-0 flex items-start md:items-end cursor-grab"
  >
    <div class="showcase-rail shrink-0 flex items-start gap-5 sm:gap-7 md:gap-6 lg:gap-8 px-4 sm:px-6 md:px-10">
      {PROJECTS.map((project, index) => {
        const href = getProjectPath(lang, project.slug);
        const ratio = COVER_ASPECT_RATIOS[project.coverAspect];
        return (
          <article
            style={`--r: ${ratio};`}
            class="showcase-card shrink-0 snap-start snap-always md:snap-align-none flex flex-col"
          >
            <a href={href} class="group flex flex-col w-full focus:outline-none">
              <div class="mb-2.5 md:mb-3 md:min-h-[38px] 2xl:min-h-[42px] flex flex-col justify-end">
                <h2 class="md:truncate">
                  {project.title[lang]}
                </h2>
                <p class="mt-0.5 md:truncate">
                  {project.role[lang]}
                </p>
              </div>

              <div
                style={`aspect-ratio: ${ratio};`}
                class="showcase-media w-full overflow-hidden bg-[#f5f5f3]"
              >
                {project.coverVideo ? (
                  <video
                    src={project.coverVideo.src}
                    poster={(project.coverVideo.poster ?? project.cover).src}
                    aria-label={project.coverAlt[lang]}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    class="w-full h-full object-cover transition-opacity duration-500 ease-out group-hover:opacity-80 pointer-events-none select-none"
                  />
                ) : (
                  <Image
                    src={project.cover}
                    alt={project.coverAlt[lang]}
                    width={1600}
                    class="w-full h-full object-cover transition-opacity duration-500 ease-out group-hover:opacity-80 pointer-events-none select-none"
                    loading={index < 3 ? 'eager' : 'lazy'}
                    draggable={false}
                  />
                )}
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </div>
</main>

<script>
  import { initHorizontalTrack } from '../scripts/horizontalScroll';
  initHorizontalTrack();
</script>

<style>
  .showcase-card {
    width: calc(100vw - 64px);
  }

  @media (min-width: 640px) {
    .showcase-card {
      width: calc(100vw - 96px);
    }
  }

  @media (min-width: 768px) {
    .showcase-rail {
      --rail-h: clamp(280px, min(58vh, 46vw), 560px);
    }

    .showcase-card {
      width: calc(var(--rail-h) * var(--r));
    }

    .showcase-media {
      height: var(--rail-h);
      width: 100%;
    }
  }

  @supports (height: 1svh) {
    @media (min-width: 768px) {
      .showcase-rail {
        --rail-h: clamp(280px, min(58svh, 46vw), 560px);
      }
    }
  }
</style>
