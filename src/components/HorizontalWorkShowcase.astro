---
import { Image } from 'astro:assets';
import { PROJECTS, type CoverAspect } from '../data/projects';
import { getProjectPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const MOBILE_CARD_WIDTH_CLASS = 'w-[calc(100vw-48px)] sm:w-[calc(100vw-72px)]';

const DESKTOP_CARD_ASPECT_CLASSES: Record<CoverAspect, string> = {
  '2/3': 'md:w-[min(40vw,calc(66svh*2/3))] lg:w-[min(33vw,500px,calc(66svh*2/3))]',
  '3/4': 'md:w-[min(40vw,calc(66svh*3/4))] lg:w-[min(33vw,500px,calc(66svh*3/4))]',
  '4/5': 'md:w-[min(40vw,calc(66svh*4/5))] lg:w-[min(33vw,500px,calc(66svh*4/5))]',
  '1/1': 'md:w-[min(40vw,66svh)] lg:w-[min(33vw,500px,66svh)]',
  '5/4': 'md:w-[min(40vw,calc(66svh*5/4))] lg:w-[min(33vw,500px,calc(66svh*5/4))]',
  '4/3': 'md:w-[min(40vw,calc(66svh*4/3))] lg:w-[min(33vw,500px,calc(66svh*4/3))]',
  '3/2': 'md:w-[min(40vw,calc(66svh*3/2))] lg:w-[min(33vw,500px,calc(66svh*3/2))]',
};

const ASPECT_MEDIA_CLASSES: Record<CoverAspect, string> = {
  '2/3': 'aspect-[2/3] w-[min(100%,calc(70dvh*2/3))] md:w-full',
  '3/4': 'aspect-[3/4] w-[min(100%,calc(70dvh*3/4))] md:w-full',
  '4/5': 'aspect-[4/5] w-[min(100%,calc(70dvh*4/5))] md:w-full',
  '1/1': 'aspect-square w-[min(100%,70dvh)] md:w-full',
  '5/4': 'aspect-[5/4] w-[min(100%,calc(70dvh*5/4))] md:w-full',
  '4/3': 'aspect-[4/3] w-[min(100%,calc(70dvh*4/3))] md:w-full',
  '3/2': 'aspect-[3/2] w-[min(100%,calc(70dvh*3/2))] md:w-full',
};
---

<main class="flex-1 min-h-0 relative overflow-hidden pt-14 md:pt-16 pb-[calc(2rem+env(safe-area-inset-bottom))] md:pb-10">
  <div
    data-horizontal-track
    class="no-scrollbar h-full w-full overflow-x-auto overflow-y-hidden snap-x snap-mandatory md:snap-none scroll-pl-3.5 sm:scroll-pl-6 md:scroll-pl-0 flex items-end cursor-grab"
  >
    <div class="shrink-0 flex items-start gap-3.5 sm:gap-5 md:gap-6 lg:gap-8 px-3.5 sm:px-6 md:px-10">
      {PROJECTS.map((project, index) => {
        const num = String(index + 1).padStart(2, '0');
        const href = getProjectPath(lang, project.slug);
        return (
          <article
            class:list={[
              'shrink-0 snap-start md:snap-align-none flex flex-col',
              MOBILE_CARD_WIDTH_CLASS,
              DESKTOP_CARD_ASPECT_CLASSES[project.coverAspect],
            ]}
          >
            <a href={href} class="group flex flex-col w-full focus:outline-none">
              <div class="mb-3 flex items-baseline justify-between gap-3 text-[12px] leading-[1.35] md:min-h-[52px] lg:min-h-0">
                <div class="min-w-0">
                  <div class="flex items-baseline md:gap-2.5">
                    <span class="hidden md:inline tabular-nums text-[#737373] shrink-0">{num}</span>
                    <h2 class="text-[#141414] font-normal group-hover:underline underline-offset-4 decoration-1">
                      {project.title[lang]}
                    </h2>
                  </div>
                  <p class="mt-0.5 md:pl-[calc(2ch+0.625rem)] text-[11px] tracking-[0.02em] text-[#737373]">
                    {project.subtitle[lang]}
                  </p>
                </div>
                <span class="hidden md:inline shrink-0 text-[11px] uppercase tracking-[0.04em] text-[#737373] tabular-nums">
                  {project.year}
                </span>
              </div>

              <div
                class:list={[
                  'overflow-hidden bg-[#f5f5f3]',
                  ASPECT_MEDIA_CLASSES[project.coverAspect],
                ]}
              >
                <Image
                  src={project.cover}
                  alt={project.coverAlt[lang]}
                  width={1400}
                  class="w-full h-full object-cover transition-opacity duration-500 ease-out group-hover:opacity-80 pointer-events-none select-none"
                  loading={index < 3 ? 'eager' : 'lazy'}
                  draggable={false}
                />
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </div>
</main>

<script>
  import { initHorizontalTrack } from '../scripts/horizontalScroll';
  initHorizontalTrack();
</script>
