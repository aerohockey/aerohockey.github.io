---
import { Image } from 'astro:assets';
import { PROJECTS, type CoverAspect } from '../data/projects';
import { getProjectPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const CARD_ASPECT_WIDTH_CLASSES: Record<CoverAspect, string> = {
  '2/3':
    'w-[min(calc(100vw-48px),calc(76dvh*2/3))] sm:w-[min(calc(100vw-72px),calc(76dvh*2/3))] md:w-[min(40vw,calc(66svh*2/3))] lg:w-[min(33vw,500px,calc(66svh*2/3))]',
  '3/4':
    'w-[min(calc(100vw-48px),calc(76dvh*3/4))] sm:w-[min(calc(100vw-72px),calc(76dvh*3/4))] md:w-[min(40vw,calc(66svh*3/4))] lg:w-[min(33vw,500px,calc(66svh*3/4))]',
  '4/5':
    'w-[min(calc(100vw-48px),calc(76dvh*4/5))] sm:w-[min(calc(100vw-72px),calc(76dvh*4/5))] md:w-[min(40vw,calc(66svh*4/5))] lg:w-[min(33vw,500px,calc(66svh*4/5))]',
  '1/1':
    'w-[min(calc(100vw-48px),76dvh)] sm:w-[min(calc(100vw-72px),76dvh)] md:w-[min(40vw,66svh)] lg:w-[min(33vw,500px,66svh)]',
  '5/4':
    'w-[min(calc(100vw-48px),calc(76dvh*5/4))] sm:w-[min(calc(100vw-72px),calc(76dvh*5/4))] md:w-[min(40vw,calc(66svh*5/4))] lg:w-[min(33vw,500px,calc(66svh*5/4))]',
  '4/3':
    'w-[min(calc(100vw-48px),calc(76dvh*4/3))] sm:w-[min(calc(100vw-72px),calc(76dvh*4/3))] md:w-[min(40vw,calc(66svh*4/3))] lg:w-[min(33vw,500px,calc(66svh*4/3))]',
  '3/2':
    'w-[min(calc(100vw-48px),calc(76dvh*3/2))] sm:w-[min(calc(100vw-72px),calc(76dvh*3/2))] md:w-[min(40vw,calc(66svh*3/2))] lg:w-[min(33vw,500px,calc(66svh*3/2))]',
};

const ASPECT_RATIO_CLASSES: Record<CoverAspect, string> = {
  '2/3': 'aspect-[2/3]',
  '3/4': 'aspect-[3/4]',
  '4/5': 'aspect-[4/5]',
  '1/1': 'aspect-square',
  '5/4': 'aspect-[5/4]',
  '4/3': 'aspect-[4/3]',
  '3/2': 'aspect-[3/2]',
};
---

<main class="flex-1 min-h-0 relative overflow-hidden pt-14 md:pt-16 pb-[calc(2rem+env(safe-area-inset-bottom))] md:pb-10">
  <div
    data-horizontal-track
    class="no-scrollbar h-full w-full overflow-x-auto overflow-y-hidden snap-x snap-mandatory md:snap-none scroll-pl-3.5 sm:scroll-pl-6 md:scroll-pl-0 flex items-end cursor-grab"
  >
    <div class="showcase-rail shrink-0 flex items-start gap-3.5 sm:gap-5 md:gap-6 lg:gap-8 px-3.5 sm:px-6 md:px-10">
      {PROJECTS.map((project, index) => {
        const href = getProjectPath(lang, project.slug);
        return (
          <article
            class:list={[
              'shrink-0 snap-start md:snap-align-none flex flex-col',
              CARD_ASPECT_WIDTH_CLASSES[project.coverAspect],
            ]}
          >
            <a href={href} class="group flex flex-col w-full focus:outline-none">
              <div class="mb-3 text-[12px] leading-[1.35]">
                <h2 class="text-[#141414] font-normal">
                  {project.title[lang]}
                </h2>
                <p class="mt-0.5 text-[11px] tracking-[0.02em] text-[#737373]">
                  {project.subtitle[lang]}
                </p>
              </div>

              <div
                class:list={[
                  'w-full overflow-hidden bg-[#f5f5f3]',
                  ASPECT_RATIO_CLASSES[project.coverAspect],
                ]}
              >
                <Image
                  src={project.cover}
                  alt={project.coverAlt[lang]}
                  width={1400}
                  class="w-full h-full object-cover transition-opacity duration-500 ease-out group-hover:opacity-80 pointer-events-none select-none"
                  loading={index < 3 ? 'eager' : 'lazy'}
                  draggable={false}
                />
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </div>
</main>

<script>
  import { initHorizontalTrack } from '../scripts/horizontalScroll';
  initHorizontalTrack();
</script>

<style>
  .showcase-rail {
    --rail-h: min(calc((100vw - 48px) * 3 / 2), 76dvh);
    min-height: calc(var(--rail-h) + 45px);
  }

  @media (min-width: 640px) {
    .showcase-rail {
      --rail-h: min(calc((100vw - 72px) * 3 / 2), 76dvh);
    }
  }

  @media (min-width: 768px) {
    .showcase-rail {
      min-height: 0;
    }
  }
</style>
