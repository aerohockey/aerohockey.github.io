---
import { Image } from 'astro:assets';
import { PROJECTS, type CardOffset, type CardSize } from '../data/projects';
import { getProjectPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const SIZE_CLASSES: Record<CardSize, string> = {
  hero: 'w-[86vw] sm:w-[68vw] md:w-[30vw] lg:w-[25vw] md:max-w-[400px]',
  tall: 'w-[82vw] sm:w-[64vw] md:w-[24vw] lg:w-[21vw] md:max-w-[340px]',
  compact: 'w-[78vw] sm:w-[60vw] md:w-[23vw] lg:w-[20vw] md:max-w-[310px]',
  wide: 'w-[88vw] sm:w-[74vw] md:w-[40vw] lg:w-[35vw] md:max-w-[560px]',
};

const OFFSET_CLASSES: Record<CardOffset, string> = {
  center: 'translate-y-0',
  up: '-translate-y-2.5 sm:-translate-y-4 md:-translate-y-9',
  down: 'translate-y-2.5 sm:translate-y-4 md:translate-y-9',
};

const ASPECT_CLASSES: Record<'4/5' | '3/2' | '4/4' | '3/4', string> = {
  '4/5': 'aspect-[4/5]',
  '3/2': 'aspect-[3/2]',
  '4/4': 'aspect-square',
  '3/4': 'aspect-[3/4]',
};
---

<main class="flex-1 relative overflow-hidden pt-14 md:pt-14 pb-6 md:pb-8">
  <div
    data-horizontal-track
    class="no-scrollbar h-full w-full overflow-x-auto overflow-y-hidden snap-x snap-proximity md:snap-none flex items-center gap-4 sm:gap-8 md:gap-24 lg:gap-28 px-3.5 sm:px-6 md:px-14 lg:px-20 pr-8 md:pr-28 cursor-grab"
  >
    {PROJECTS.map((project, index) => {
      const num = String(index + 1).padStart(2, '0');
      const href = getProjectPath(lang, project.slug);
      return (
        <article
          class:list={[
            'shrink-0 snap-center md:snap-align-none flex flex-col',
            SIZE_CLASSES[project.cardSize],
            OFFSET_CLASSES[project.cardOffset],
          ]}
        >
          <a href={href} class="group block focus:outline-none">
            <div
              class:list={[
                'w-full overflow-hidden bg-[#f5f5f3] max-h-[68svh] md:max-h-[58svh]',
                ASPECT_CLASSES[project.coverAspect],
              ]}
            >
              <Image
                src={project.cover}
                alt={project.coverAlt[lang]}
                width={1400}
                class="w-full h-full object-cover transition-opacity duration-500 ease-out group-hover:opacity-80 pointer-events-none select-none"
                loading={index < 3 ? 'eager' : 'lazy'}
                draggable={false}
              />
            </div>

            <div class="mt-3 flex items-baseline justify-between gap-3 text-[12px] leading-[1.35]">
              <div class="min-w-0">
                <div class="flex items-baseline gap-2.5">
                  <span class="tabular-nums text-[#737373] shrink-0">{num}</span>
                  <h2 class="text-[#141414] font-normal group-hover:underline underline-offset-4 decoration-1">
                    {project.title[lang]}
                  </h2>
                </div>
                <p class="mt-0.5 pl-[calc(2ch+0.625rem)] text-[11px] tracking-[0.02em] text-[#737373]">
                  {project.subtitle[lang]}
                </p>
              </div>
              <span class="shrink-0 text-[11px] uppercase tracking-[0.04em] text-[#737373] tabular-nums hidden sm:inline">
                {project.year}
              </span>
            </div>
          </a>
        </article>
      );
    })}
  </div>
</main>

<script>
  import { initHorizontalTrack } from '../scripts/horizontalScroll';
  initHorizontalTrack();
</script>
