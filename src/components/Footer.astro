---
import { UI, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  fixed?: boolean;
  showProgress?: boolean;
}

const { lang, fixed = false, showProgress = false } = Astro.props;
const t = UI[lang];
---

<footer
  class:list={[
    'z-30 bg-white/95 backdrop-blur-sm px-5 md:px-10 py-3.5 md:py-4 text-[11px] md:text-[12px] leading-[1.15] tracking-[0.04em] uppercase text-[#737373]',
    fixed ? 'fixed bottom-0 inset-x-0' : 'mt-auto border-t border-black/8',
  ]}
>
  {showProgress && (
    <div class="absolute top-0 inset-x-5 md:inset-x-10 h-px bg-black/10 overflow-hidden">
      <div
        data-scroll-progress
        class="h-full bg-[#141414] w-0 transition-[width] duration-75 ease-out"
      />
    </div>
  )}
  <div class="flex items-center justify-between gap-4">
    <span class="truncate">{t.role}</span>
    {showProgress ? (
      <span class="shrink-0 flex items-center gap-4 tabular-nums">
        <span data-counter-mobile class="md:hidden">01</span>
        <span class="text-[#141414]">{t.scrollHint}</span>
      </span>
    ) : (
      <span class="shrink-0 tabular-nums">{t.copyright}</span>
    )}
  </div>
</footer>
