---
import { Image } from 'astro:assets';
import { getNextProject, type ProjectItem } from '../data/projects';
import { UI, getHomePath, getProjectPath, type Lang } from '../i18n/ui';

interface Props {
  project: ProjectItem;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = UI[lang];
const frames = project.gallery ?? [
  {
    image: project.cover,
    alt: project.coverAlt,
    orientation: 'portrait' as const,
  },
];
const nextProject = getNextProject(project.slug);
const homeHref = getHomePath(lang);
const nextHref = getProjectPath(lang, nextProject.slug);
---

<main class="flex-1 min-h-0 relative overflow-hidden pt-14 md:pt-16 pb-[calc(2rem+env(safe-area-inset-bottom))] md:pb-10">
  <div
    data-horizontal-track
    class="no-scrollbar h-full w-full overflow-x-auto overflow-y-hidden snap-x snap-mandatory md:snap-none scroll-pl-3.5 sm:scroll-pl-6 md:scroll-pl-0 flex items-end cursor-grab"
  >
    <div class="shrink-0 flex items-start gap-2.5 sm:gap-4 md:gap-6 lg:gap-8 px-3.5 sm:px-6 md:px-10">
      <!-- Opening editorial info slide -->
      <section
        class="shrink-0 snap-start md:snap-align-none w-[calc(100vw-38px)] sm:w-[calc(100vw-60px)] md:w-[320px] lg:w-[360px] flex flex-col pr-4 md:pr-6"
      >
        <a
          href={homeHref}
          class="inline-flex items-center gap-1.5 text-[11px] sm:text-[12px] leading-[1.25] text-[#737373] hover:text-[#141414] transition-colors w-fit"
        >
          <span aria-hidden="true">←</span>
          <span>{t.backToWork}</span>
        </a>

        <div class="mt-8 md:mt-10 space-y-3">
          <p class="text-[11px] leading-[1.35] text-[#737373] tabular-nums">
            {project.category[lang]} · {project.year}
          </p>

          <h1 class="text-[24px] sm:text-[28px] md:text-[30px] font-normal leading-[1.14] tracking-[-0.015em] text-[#141414]">
            {project.title[lang]}
          </h1>

          {project.intro && (
            <p class="pt-1 text-[13px] sm:text-[14px] leading-[1.6] text-[#525252]">
              {project.intro[lang]}
            </p>
          )}
        </div>
      </section>

      <!-- Horizontal gallery photographs -->
      {frames.map((frame, index) => {
        const ratio = Number((frame.image.width / frame.image.height).toFixed(4));
        return (
          <figure class="shrink-0 snap-start md:snap-align-none w-[calc(100vw-38px)] sm:w-[calc(100vw-60px)] md:w-auto flex flex-col items-start">
            <div
              style={`--r: ${ratio}; aspect-ratio: ${frame.image.width} / ${frame.image.height};`}
              class="overflow-hidden bg-[#f5f5f3] w-[min(100%,calc(78dvh*var(--r)))] md:w-[min(82vw,calc(74svh*var(--r)))] lg:w-[min(82vw,calc(78svh*var(--r)))]"
            >
              <Image
                src={frame.image}
                alt={frame.alt[lang]}
                width={1800}
                class="w-full h-full object-cover pointer-events-none select-none"
                loading={index < 2 ? 'eager' : 'lazy'}
                draggable={false}
              />
            </div>
          </figure>
        );
      })}

      <!-- End card to next project -->
      <section
        class="shrink-0 snap-start md:snap-align-none w-[calc(100vw-38px)] sm:w-[calc(100vw-60px)] md:w-[260px] flex flex-col items-start space-y-2.5 pl-1 md:pl-4"
      >
        <span class="text-[11px] leading-[1.35] text-[#737373]">
          {t.nextProject}
        </span>
        <a
          href={nextHref}
          class="text-[20px] sm:text-[24px] font-normal leading-[1.2] text-[#141414] hover:opacity-55 transition-opacity"
        >
          {nextProject.title[lang]} →
        </a>
      </section>
    </div>
  </div>
</main>

<script>
  import { initHorizontalTrack } from '../scripts/horizontalScroll';
  initHorizontalTrack();
</script>
