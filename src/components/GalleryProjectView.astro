---
import { Image } from 'astro:assets';
import type { ProjectItem } from '../data/projects';
import type { Lang } from '../i18n/ui';

interface Props {
  project: ProjectItem;
  lang: Lang;
}

const { project, lang } = Astro.props;
const frames = project.gallery ?? [
  {
    image: project.cover,
    alt: project.coverAlt,
    orientation: 'portrait' as const,
  },
];
---

<main class="flex-1 min-h-0 relative overflow-hidden pt-14 md:pt-16 pb-[calc(2rem+env(safe-area-inset-bottom))] md:pb-10">
  <div
    data-horizontal-track
    class="no-scrollbar h-full w-full overflow-x-auto overflow-y-hidden snap-x snap-mandatory md:snap-none scroll-pl-3.5 sm:scroll-pl-6 md:scroll-pl-0 flex items-end cursor-grab"
  >
    <div class="gallery-rail shrink-0 flex items-start gap-3.5 sm:gap-5 md:gap-6 lg:gap-8 px-3.5 sm:px-6 md:px-10">
      <!-- Opening editorial info slide -->
      <section
        class="shrink-0 snap-start md:snap-align-none w-[calc(100vw-48px)] sm:w-[calc(100vw-72px)] md:w-[320px] lg:w-[360px] flex flex-col space-y-2.5 pr-4 md:pr-6"
      >
        <h1 class="text-[15px] sm:text-[16px] font-normal leading-[1.25] tracking-[-0.01em] text-[#141414]">
          {project.title[lang]}
        </h1>

        {project.intro && (
          <p class="text-[13px] leading-[1.55] text-[#737373]">
            {project.intro[lang]}
          </p>
        )}
      </section>

      <!-- Horizontal gallery photographs -->
      {frames.map((frame, index) => {
        const ratio = Number((frame.image.width / frame.image.height).toFixed(4));
        return (
          <figure class="shrink-0 snap-start md:snap-align-none flex flex-col items-start">
            <div
              style={`--r: ${ratio}; aspect-ratio: ${frame.image.width} / ${frame.image.height};`}
              class="gallery-frame overflow-hidden bg-[#f5f5f3]"
            >
              <Image
                src={frame.image}
                alt={frame.alt[lang]}
                width={1400}
                class="w-full h-full object-cover pointer-events-none select-none"
                loading={index < 2 ? 'eager' : 'lazy'}
                draggable={false}
              />
            </div>
          </figure>
        );
      })}
    </div>
  </div>
</main>

<style>
  .gallery-rail {
    --rail-h: min(calc((100vw - 48px) * 3 / 2), 76dvh);
    min-height: var(--rail-h);
  }

  .gallery-frame {
    width: min(calc(100vw - 48px), calc(var(--rail-h) * var(--r)));
  }

  @media (min-width: 640px) {
    .gallery-rail {
      --rail-h: min(calc((100vw - 72px) * 3 / 2), 76dvh);
    }

    .gallery-frame {
      width: min(calc(100vw - 72px), calc(var(--rail-h) * var(--r)));
    }
  }

  @media (min-width: 768px) {
    .gallery-rail {
      --rail-h: min(calc(40vw * 5 / 4), 66svh);
    }

    .gallery-frame {
      width: min(40vw, calc(var(--rail-h) * var(--r)));
    }
  }

  @media (min-width: 1024px) {
    .gallery-rail {
      --rail-h: min(calc(33vw * 5 / 4), 625px, 66svh);
    }

    .gallery-frame {
      width: min(33vw, 500px, calc(var(--rail-h) * var(--r)));
    }
  }
</style>

<script>
  import { initHorizontalTrack } from '../scripts/horizontalScroll';
  initHorizontalTrack();
</script>
