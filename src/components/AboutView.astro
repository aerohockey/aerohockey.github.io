---
import { Image } from 'astro:assets';
import aboutPortrait from '../assets/draft/about-portrait.jpg';
import { getContactPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const contactHref = getContactPath(lang);

const content = {
  en: {
    eyebrow: 'About',
    headline: 'Art director with a camera, based in Saint Petersburg.',
    paragraphs: [
      'I build visual strategies, direct and shoot photography and video for brands, helping businesses look cohesive and confident.',
      'Currently developing Guest — a quiet native iOS app showcasing one photographer every week.',
    ],
    clientsLabel: 'Selected clients',
    clients: 'Apple, Adidas, Samokat, KFC, Lensa, FIFA, etc.',
    contactCta: 'Get in touch →',
  },
  ru: {
    eyebrow: 'Обо мне',
    headline: 'Арт-директор с камерой, Санкт-Петербург.',
    paragraphs: [
      'Создаю визуальные стратегии и снимаю для брендов. Помогаю бизнесу выглядеть уверенно и цельно.',
      'Сейчас разрабатываю Guest — нативное iOS-приложение, которое знакомит с одним фотографом каждую неделю.',
    ],
    clientsLabel: 'Среди клиентов',
    clients: 'Apple, Adidas, Самокат, KFC, Lensa, FIFA и др.',
    contactCta: 'Связаться →',
  },
}[lang];
---

<main class="flex-1 px-5 md:px-10 pt-28 md:pt-32 pb-20 max-w-[1440px] w-full mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
    <div class="lg:col-span-6 lg:col-start-2 space-y-6 md:space-y-8">
      <p class="text-[11px] uppercase tracking-[0.08em] text-[#737373]">
        {content.eyebrow}
      </p>
      <h1 class="text-[28px] sm:text-[34px] md:text-[38px] font-normal leading-[1.14] tracking-[-0.015em] text-[#141414]">
        {content.headline}
      </h1>
      <div class="space-y-4 text-[16px] leading-[1.6] text-[#262626] max-w-[48ch]">
        {content.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>

      <div class="pt-4 border-t border-black/10 space-y-1.5 max-w-[48ch]">
        <p class="text-[11px] uppercase tracking-[0.06em] text-[#737373]">
          {content.clientsLabel}
        </p>
        <p class="text-[15px] leading-[1.5] text-[#141414]">
          {content.clients}
        </p>
      </div>

      <div class="pt-2">
        <a
          href={contactHref}
          class="inline-block text-[12px] uppercase tracking-[0.06em] text-[#141414] underline underline-offset-4 hover:opacity-60 transition-opacity"
        >
          {content.contactCta}
        </a>
      </div>
    </div>

    <div class="lg:col-span-4 lg:col-start-8">
      <div class="aspect-[4/5] w-full max-w-[420px] bg-[#f5f5f3] overflow-hidden">
        <Image
          src={aboutPortrait}
          alt={lang === 'ru' ? 'Евгений Иванов' : 'Evgeny Ivanov'}
          width={1100}
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
    </div>
  </div>
</main>
