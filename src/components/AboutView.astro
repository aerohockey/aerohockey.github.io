---
import { Image } from 'astro:assets';
import aboutPortrait from '../assets/draft/about-portrait.jpg';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const content = {
  en: {
    headline: 'Art director with a camera, based in Saint Petersburg.',
    paragraphs: [
      'I build visual strategies, direct and shoot photography and video for brands, helping businesses look cohesive and confident.',
      'Currently developing Guest — a quiet native iOS app showcasing one photographer every week.',
    ],
    clientsLabel: 'Selected clients',
    clients: 'Apple, Adidas, Samokat, KFC, Lensa, FIFA, etc.',
  },
  ru: {
    headline: 'Арт-директор с камерой, Санкт-Петербург.',
    paragraphs: [
      'Создаю визуальные стратегии и снимаю для брендов. Помогаю бизнесу выглядеть уверенно и цельно.',
      'Сейчас разрабатываю Guest — нативное iOS-приложение, которое знакомит с одним фотографом каждую неделю.',
    ],
    clientsLabel: 'Среди клиентов',
    clients: 'Apple, Adidas, Самокат, KFC, Lensa, FIFA и др.',
  },
}[lang];
---

<main class="flex-1 min-h-0 overflow-y-auto flex flex-col pt-20 md:pt-16 pb-[calc(0.875rem+env(safe-area-inset-bottom))] md:pb-10 px-3.5 sm:px-6 md:px-10">
  <div class="about-rail mt-auto w-full flex flex-col md:flex-row md:items-start gap-5 md:gap-6 lg:gap-8">
    <section class="w-full md:w-[320px] lg:w-[360px] shrink-0 flex flex-col space-y-4 md:space-y-6 md:pr-6">
      <div class="space-y-2.5">
        <h1 class="text-[16px] 2xl:text-[18px] font-medium leading-[1.25] tracking-[-0.01em] text-[#141414]">
          {content.headline}
        </h1>

        <div class="space-y-3 text-[14px] 2xl:text-[15px] leading-[1.55] text-[#141414]">
          {content.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </div>

      <div class="space-y-1 text-[14px] 2xl:text-[15px] leading-[1.55] text-[#141414]">
        <h2 class="font-medium">{content.clientsLabel}</h2>
        <p>{content.clients}</p>
      </div>
    </section>

    <figure class="shrink-0 flex flex-col items-start">
      <div class="about-frame aspect-[3/2] overflow-hidden bg-[#f5f5f3]">
        <Image
          src={aboutPortrait}
          alt={lang === 'ru' ? 'Евгений Иванов' : 'Evgeny Ivanov'}
          width={1400}
          class="w-full h-full object-cover pointer-events-none select-none"
          loading="eager"
          draggable={false}
        />
      </div>
    </figure>
  </div>
</main>

<style>
  .about-rail {
    --rail-h: min(calc((100vw - 48px) * 4 / 3), var(--rail-vh));
    min-height: calc(var(--rail-h) + var(--caption-h));
  }

  .about-frame {
    width: 100%;
    max-width: 500px;
  }

  @media (min-width: 640px) {
    .about-rail {
      --rail-h: min(calc((100vw - 72px) * 4 / 3), var(--rail-vh));
    }
  }

  @media (min-width: 768px) {
    .about-rail {
      --rail-h: min(calc(40vw * 5 / 4), var(--rail-svh));
    }

    .about-frame {
      max-width: none;
      width: 40vw;
      width: min(40vw, calc(var(--rail-h) * 1.5));
    }
  }

  @media (min-width: 1024px) {
    .about-rail {
      --rail-h: min(calc(33vw * 5 / 4), 625px, var(--rail-svh));
    }

    .about-frame {
      width: min(33vw, 500px);
      width: min(33vw, 500px, calc(var(--rail-h) * 1.5));
    }
  }
</style>
