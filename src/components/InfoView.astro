---
import ResponsiveImage from './ResponsiveImage.astro';
import type { Lang } from '../i18n/ui';
import { getSiteSettings } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const settings = await getSiteSettings();

const contactLabels = {
  en: {
    contactLabel: 'Contact',
    emailLabel: 'Email',
    telegramLabel: 'Telegram',
    phoneLabel: 'Phone',
  },
  ru: {
    contactLabel: 'Контакты',
    emailLabel: 'Почта',
    telegramLabel: 'Telegram',
    phoneLabel: 'Телефон',
  },
}[lang];
---

<main class="flex-1 flex flex-col justify-between pt-[96px] md:pt-[var(--page-top-desktop)] pb-[calc(2rem+env(safe-area-inset-bottom))] md:pb-4 px-4 text-[14px] md:text-[13px] 2xl:text-[15px] leading-[1.5] font-normal text-[#141414]">
  <div class="w-full flex flex-col md:flex-row md:items-start gap-8 md:gap-10 lg:gap-14">
    <!-- Left column: positioning, bio, focus, clients, contacts -->
    <section class="w-full md:w-[360px] lg:w-[400px] shrink-0 space-y-6">
      <div class="space-y-3">
        <h1>{settings.aboutHeadline[lang]}</h1>
        <p>{settings.aboutBio[lang]}</p>
      </div>

      <div class="space-y-1">
        <h2>{settings.focusLabel[lang]}</h2>
        <p>{settings.focus[lang]}</p>
      </div>

      <div class="space-y-1">
        <h2>{settings.clientsLabel[lang]}</h2>
        <p>{settings.clients[lang]}</p>
      </div>

      <div>
        <h2 class="sr-only">{contactLabels.contactLabel}</h2>

        <dl class="space-y-1.5 md:space-y-1">
          <div class="flex items-baseline gap-3 md:gap-4">
            <dt class="shrink-0 w-[76px]">
              {contactLabels.emailLabel}
            </dt>
            <dd class="min-w-0">
              <a
                href={`mailto:${settings.email}`}
                class="inline-block py-0.5 -my-0.5 hover:opacity-55 transition-opacity"
              >
                {settings.email}
              </a>
            </dd>
          </div>

          <div class="flex items-baseline gap-3 md:gap-4">
            <dt class="shrink-0 w-[76px]">
              {contactLabels.telegramLabel}
            </dt>
            <dd class="min-w-0">
              <a
                href={settings.telegramUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block py-0.5 -my-0.5 hover:opacity-55 transition-opacity"
              >
                {settings.telegramHandle}
              </a>
            </dd>
          </div>

          <div class="flex items-baseline gap-3 md:gap-4">
            <dt class="shrink-0 w-[76px]">
              {contactLabels.phoneLabel}
            </dt>
            <dd class="min-w-0">
              <a
                href={settings.phoneHref}
                class="inline-block py-0.5 -my-0.5 hover:opacity-55 transition-opacity tabular-nums"
              >
                {settings.phoneDisplay}
              </a>
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Right column: portrait -->
    <figure class="flex-1 min-w-0 flex flex-col items-start">
      <div class="w-full max-w-[540px] aspect-[3/2] overflow-hidden bg-[#f5f5f3]">
        <ResponsiveImage
          image={settings.aboutPortrait}
          alt={settings.aboutPortraitAlt[lang]}
          width={1400}
          sizes="(max-width: 767px) 100vw, 540px"
          class="w-full h-full object-cover pointer-events-none select-none"
          loading="eager"
          draggable={false}
        />
      </div>
    </figure>
  </div>

  <!-- Quiet colophon -->
  {settings.showColophon && (
    <footer class="mt-12 md:mt-auto pt-8 md:pt-12">
      <span>{settings.colophonLabel[lang]} </span>
      <a
        href={settings.colophonUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="underline underline-offset-2 hover:opacity-55 transition-opacity"
      >
        {settings.colophonLinkText}
      </a>
    </footer>
  )}
</main>
