---
import MediaFrame from './MediaFrame.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import {
  getNextProject,
  type CmsMediaAsset,
  type CmsProject,
} from '../lib/content';
import { UI, getProjectPath, type Lang } from '../i18n/ui';
import { getPosterUrl } from '../lib/sanity';

interface Props {
  project: CmsProject;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = UI[lang];
const nextProject = await getNextProject(project.slug);
const nextHref = nextProject ? getProjectPath(lang, nextProject.slug) : undefined;

const headline = project.landingHeadline?.[lang] ?? project.title[lang];
const leadParagraphs = project.landingLeadParagraphs ?? [];
const blocks = project.landingBlocks ?? [];

const COL = 'w-full max-w-[640px] 2xl:max-w-[700px] mx-auto';
const FULL_PHONE = 'w-full max-w-[480px] 2xl:max-w-[540px] mx-auto';

function localizeHref(href: string): string {
  if (!href.startsWith('/') || lang !== 'ru') return href;
  return href.startsWith('/ru/') ? href : `/ru${href}`;
}

function getMediaRatio(asset: CmsMediaAsset): number {
  if (asset.type === 'video') return asset.aspectRatio;
  if (asset.image.kind === 'local') {
    return Number((asset.image.asset.width / asset.image.asset.height).toFixed(4));
  }
  return asset.image.aspectRatio;
}
---

<main
  data-guest-canvas
  class="relative flex-1 bg-white text-[#141414] text-[14px] md:text-[13px] 2xl:text-[15px] leading-[1.5] font-normal [&_p]:text-pretty"
>
  <section class="relative z-10 px-4 pt-[96px] md:pt-[var(--page-top-desktop)] pb-[calc(2.5rem+env(safe-area-inset-bottom))] md:pb-24">
    <div class={`${COL} flex flex-col gap-11 md:gap-15`}>
      <div>
        <h1 class="leading-[1.35]">
          {headline}
        </h1>
        <p class="mt-0.5 leading-[1.35]">
          <span>{project.role[lang]}</span>
          {project.status && (
            <span class="block">{project.status[lang]}</span>
          )}
        </p>

        {project.appStoreUrl && (
          <div class="mt-4">
            <a
              href={project.appStoreUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block py-2 -my-2 md:py-0 md:my-0 underline underline-offset-4 hover:opacity-55 transition-opacity"
            >
              {t.downloadAppStore}
            </a>
          </div>
        )}

        {leadParagraphs.length > 0 && (
          <div class="mt-5 md:mt-6 space-y-3.5">
            {leadParagraphs.map((paragraph) => (
              <p>{paragraph[lang]}</p>
            ))}
          </div>
        )}
      </div>

      {blocks.map((block, index) => {
        if (block.kind === 'text') {
          const isStacked = block.items.length > 1;
          return (
            <div data-reveal="text" class={isStacked ? 'space-y-6 md:space-y-7' : undefined}>
              {block.items.map((item) => (
                <div>
                  {item.heading && (
                    <h2 class="leading-[1.35]">
                      {item.heading[lang]}
                    </h2>
                  )}
                  <div class={item.heading ? 'mt-2 space-y-3.5' : 'space-y-3.5'}>
                    {item.paragraphs.map((paragraph) => (
                      <p>{paragraph[lang]}</p>
                    ))}
                    {item.link && (
                      <p>
                        <a
                          href={localizeHref(item.link.href)}
                          target={item.link.href.startsWith('http') ? '_blank' : undefined}
                          rel={item.link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                          class="inline-block py-2 -my-2 md:py-0 md:my-0 underline underline-offset-4 hover:opacity-55 transition-opacity"
                        >
                          {item.link.label[lang]}
                        </a>
                      </p>
                    )}
                  </div>
                </div>
              ))}
            </div>
          );
        }

        if (block.kind === 'diptych') {
          return (
            <div data-reveal="media" class="w-full grid grid-cols-1 sm:grid-cols-2 gap-4">
              {block.items.map((item) => {
                const ratio = getMediaRatio(item);
                return (
                  <div
                    style={`aspect-ratio: ${ratio};`}
                    class="w-full overflow-hidden bg-[#f5f5f3]"
                  >
                    <MediaFrame media={item} lang={lang} width={1200} />
                  </div>
                );
              })}
            </div>
          );
        }

        const isHeroMedia = index === 0;
        const widthClass =
          block.width === 'phone'
            ? FULL_PHONE
            : block.width === 'wide'
              ? 'w-full md:w-[min(880px,calc(100vw-2rem))] md:self-center'
              : 'w-full';
        const spacingClass =
          block.spacingPreset === 'topHeavy'
            ? 'mt-3 mb-1.5 md:mt-4 md:mb-2'
            : block.spacingPreset === 'bottomHeavy'
              ? 'mt-1 mb-3 md:mt-1.5 md:mb-4'
              : '';
        const trimClass =
          block.spacingPreset === 'phoneTrim' ? '-mt-[7.2%] -mb-[6.67%]' : '';
        const imageWidth = block.width === 'phone' ? 1080 : 1600;
        const sizes =
          block.width === 'phone'
            ? '(max-width: 767px) 100vw, 540px'
            : block.width === 'wide'
              ? '(max-width: 767px) 100vw, 880px'
              : '(max-width: 767px) 100vw, 700px';

        return (
          <div
            data-reveal={isHeroMedia ? undefined : 'media'}
            class:list={[widthClass, spacingClass]}
          >
            {block.media.type === 'video' ? (
              <video
                src={block.media.src}
                poster={getPosterUrl(block.media.poster)}
                aria-label={block.media.alt[lang]}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                class:list={['w-full h-auto block select-none', trimClass]}
              />
            ) : (
              <ResponsiveImage
                image={block.media.image}
                alt={block.media.alt[lang]}
                width={imageWidth}
                sizes={sizes}
                class={['w-full h-auto block pointer-events-none select-none', trimClass]
                  .filter(Boolean)
                  .join(' ')}
                loading={isHeroMedia ? 'eager' : 'lazy'}
                draggable={false}
              />
            )}
          </div>
        );
      })}

      {nextProject && nextHref && (
        <footer
          data-reveal="text"
          class="flex justify-end"
        >
          <a
            href={nextHref}
            class="inline-flex flex-col items-end text-right min-h-[44px] md:min-h-0 hover:opacity-55 transition-opacity focus:outline-none w-fit"
          >
            <span class="leading-[1.35]">{t.nextProject}</span>
            <span class="mt-0.5 leading-[1.35]">{nextProject.title[lang]}</span>
          </a>
        </footer>
      )}
    </div>
  </section>
</main>

<style>
  [data-guest-canvas][data-reveal-ready='true'] [data-reveal='text'] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 720ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  [data-guest-canvas][data-reveal-ready='true'] [data-reveal='media'] {
    opacity: 0;
    transform: translateY(28px) scale(0.985);
    transition:
      opacity 880ms cubic-bezier(0.22, 1, 0.36, 1) 80ms,
      transform 880ms cubic-bezier(0.22, 1, 0.36, 1) 80ms;
    will-change: opacity, transform;
  }

  [data-guest-canvas][data-reveal-ready='true'] [data-reveal][data-revealed='true'] {
    opacity: 1;
    transform: none;
    will-change: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-guest-canvas][data-reveal-ready='true'] [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLElement>('[data-guest-canvas]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && !prefersReducedMotion) {
    const revealTargets = Array.from(canvas.querySelectorAll<HTMLElement>('[data-reveal]'));
    const initialTriggerY = window.innerHeight * 0.94;

    for (const el of revealTargets) {
      if (el.getBoundingClientRect().top <= initialTriggerY) {
        el.dataset.revealed = 'true';
      }
    }

    canvas.dataset.revealReady = 'true';

    const pending = revealTargets.filter((el) => el.dataset.revealed !== 'true');
    if (pending.length > 0 && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting || entry.boundingClientRect.top < window.innerHeight * 0.92) {
              const target = entry.target as HTMLElement;
              target.dataset.revealed = 'true';
              observer.unobserve(target);
            }
          }
        },
        { threshold: 0.08, rootMargin: '0px 0px -8% 0px' }
      );

      for (const el of pending) {
        observer.observe(el);
      }
    } else {
      for (const el of pending) {
        el.dataset.revealed = 'true';
      }
    }
  }
</script>
