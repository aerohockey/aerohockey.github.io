---
import { Image } from 'astro:assets';
import { GUEST_ASSETS, type ProjectItem } from '../data/projects';
import type { Lang } from '../i18n/ui';

interface Props {
  project: ProjectItem;
  lang: Lang;
}

const { project, lang } = Astro.props;

const copy = {
  en: {
    headline: 'Guest — One photographer every week',
    lead: 'This concept could have been built in many other ways — as a website, a newsletter, a web app, or a Telegram channel. Yet choosing a native iPhone app for Guest is intentional: here, content is inseparable from form, and the interface itself is part of the statement.',
    leadSub: 'Negative space, typography, tactile feedback, a pure white canvas, and the absence of visual noise make the project what it was meant to be.',
    s1Title: 'Idea and Philosophy',
    s1Text: 'We live in endless feeds where photography is reduced to thumbnails competing for two seconds of attention. Guest slows the rhythm down to one name per week — giving each author space to stay with you without algorithms, likes, or infinite scrolling.',
    s2Text: 'Once a week, on Sunday at 10:00, Guest sends a quiet notification. A new photographer arrives at midnight from Saturday to Sunday — a deliberate, predictable cadence instead of constant urgency.',
    s3Title: 'Form',
    s3Text: 'Only the photographer’s name on a pure white screen, minimal settings, and haptic nuance. The app stays calm so the work and curiosity around the author become the entire focus.',
    s4Title: 'Who is the guest?',
    s4Text: 'Curated voices across contemporary fashion, documentary, and fine-art photography — each edition highlights one photographer whose visual language deserves unhurried discovery.',
    s5Title: 'Privacy',
    s5Text: 'No accounts, no tracking pixels, no behavioral profiles, and no social noise. Guest does not collect personal analytics — it simply delivers one photographer every week.',
    s6Text: 'A quiet square widget keeps the current guest present on your iPhone Home Screen throughout the week — a subtle editorial reminder with zero clutter.',
  },
  ru: {
    headline: 'Guest — Один фотограф каждую неделю',
    lead: 'Эту идею можно было бы реализовать иначе — как сайт, рассылку, веб-приложение или канал в Telegram. Но выбор нативного приложения для iPhone здесь принципиален: в Guest форма неотделима от содержания, а сам интерфейс является частью высказывания.',
    leadSub: 'Негативное пространство, типографика, тактильный отклик, чистый белый лист и отсутствие визуального шума делают проект именно таким, каким он задумывался.',
    s1Title: 'Идея и философия',
    s1Text: 'Бесконечные ленты превратили фотографию в поток превью, которые борются за две секунды внимания. Guest замедляет ритм до одного имени в неделю — оставляя место для спокойного знакомства без алгоритмов, лайков и скролла.',
    s2Text: 'Раз в неделю, в воскресенье в 10:00, приложение присылает одно спокойное уведомление. Новый герой обновляется в полночь с субботы на воскресенье — предсказуемый ритуал вместо информационного шума.',
    s3Title: 'Форма',
    s3Text: 'На чистом белом экране — только имя фотографа, минимальные настройки и тактильный отклик. Интерфейс намеренно уходит в сторону, чтобы всё внимание оставалось на авторе.',
    s4Title: 'Кто гость?',
    s4Text: 'Кураторский выбор современных авторов из модной, документальной и арт-фотографии — каждую неделю один фотограф, к работам которого хочется вернуться без спешки.',
    s5Title: 'Приватность',
    s5Text: 'Никакой регистрации, трекеров, профилирования и скрытой аналитики. Приложение не собирает лишние данные и решает одну простую задачу.',
    s6Text: 'Минималистичный квадратный виджет держит имя текущего фотографа на домашнем экране iPhone всю неделю — как тихое напоминание без визуальной перегрузки.',
  },
}[lang];
---

<main class="flex-1 bg-white text-[#141414]">
  <!-- Part 1: White editorial opening + Screen + Idea & Philosophy + Notification crop -->
  <div class="bg-white text-[#141414]">
    <!-- Section 1: Hero title & intro -->
    <section class="px-3.5 sm:px-6 md:px-10 pt-24 sm:pt-28 md:pt-28 pb-4">
      <div class="max-w-[756px] mx-auto">
        <div class="max-w-[560px] mx-auto">
          <h1 class="text-[16px] 2xl:text-[18px] font-medium leading-[1.25] tracking-[-0.01em]">
            {copy.headline}
          </h1>
          <div class="mt-5 md:mt-6 space-y-4 text-[14px] 2xl:text-[15px] leading-[1.55]">
            <p>{copy.lead}</p>
            <p>{copy.leadSub}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: White-canvas iPhone main screen -->
    <section class="px-3.5 sm:px-6 md:px-10 py-0">
      <div class="max-w-[756px] mx-auto">
        <Image
          src={GUEST_ASSETS.screen}
          alt={project.coverAlt[lang]}
          width={1400}
          class="w-full h-auto block pointer-events-none select-none"
          loading="eager"
          draggable={false}
        />
      </div>
    </section>

    <!-- Section 3: Idea and Philosophy -->
    <section class="px-3.5 sm:px-6 md:px-10 pt-4 pb-12 md:pb-16">
      <div class="max-w-[756px] mx-auto">
        <div class="max-w-[560px] mx-auto">
          <h2 class="text-[14px] 2xl:text-[15px] font-medium leading-[1.35]">
            {copy.s1Title}
          </h2>
          <div class="mt-5 md:mt-6 space-y-4 text-[14px] 2xl:text-[15px] leading-[1.55]">
            <p>{copy.s1Text}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 4: Cropped lockscreen notification card -->
    <section class="px-3.5 sm:px-6 md:px-10 py-6 md:py-8">
      <div class="max-w-[756px] mx-auto">
        <Image
          src={GUEST_ASSETS.lockscreen}
          alt={lang === 'ru' ? 'Уведомление Guest на экране блокировки iPhone' : 'Guest notification on iPhone Lock Screen'}
          width={1600}
          class="w-full h-auto block pointer-events-none select-none"
          draggable={false}
        />
      </div>
    </section>

    <!-- Section 5: Weekly rhythm paragraph -->
    <section class="px-3.5 sm:px-6 md:px-10 pt-10 pb-20 md:pt-14 md:pb-28">
      <div class="max-w-[756px] mx-auto">
        <div class="max-w-[560px] mx-auto space-y-4 text-[14px] 2xl:text-[15px] leading-[1.55]">
          <p>{copy.s2Text}</p>
        </div>
      </div>
    </section>
  </div>

  <!-- Part 2: Pure Black contrast band — Settings + Form -->
  <div class="bg-black text-white">
    <!-- Section 6: Settings bottom sheet on pure black -->
    <section class="px-3.5 sm:px-6 md:px-10 pt-4 pb-4">
      <div class="max-w-[756px] mx-auto">
        <Image
          src={GUEST_ASSETS.settings}
          alt={lang === 'ru' ? 'Настройки еженедельного уведомления Guest' : 'Guest weekly notification settings'}
          width={1400}
          class="w-full h-auto block pointer-events-none select-none"
          draggable={false}
        />
      </div>
    </section>

    <!-- Section 7: Form -->
    <section class="px-3.5 sm:px-6 md:px-10 pt-0 pb-20 md:pb-28">
      <div class="max-w-[756px] mx-auto">
        <div class="max-w-[560px] mx-auto">
          <h2 class="text-[14px] 2xl:text-[15px] font-medium leading-[1.35]">
            {copy.s3Title}
          </h2>
          <div class="mt-5 md:mt-6 space-y-4 text-[14px] 2xl:text-[15px] leading-[1.55]">
            <p>{copy.s3Text}</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Part 3: White band — Who is the guest? + Home Screen widget + Privacy -->
  <div class="bg-white text-[#141414]">
    <!-- Section 8: Who is the guest? -->
    <section class="px-3.5 sm:px-6 md:px-10 pt-14 pb-10 md:pt-16 md:pb-14">
      <div class="max-w-[756px] mx-auto">
        <div class="max-w-[560px] mx-auto">
          <h2 class="text-[14px] 2xl:text-[15px] font-medium leading-[1.35]">
            {copy.s4Title}
          </h2>
          <div class="mt-5 md:mt-6 space-y-4 text-[14px] 2xl:text-[15px] leading-[1.55]">
            <p>{copy.s4Text}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 9: Home Screen widget -->
    <section class="px-3.5 sm:px-6 md:px-10 py-6 md:py-8">
      <div class="max-w-[756px] mx-auto">
        <Image
          src={GUEST_ASSETS.widget}
          alt={lang === 'ru' ? 'Виджет Guest на домашнем экране iPhone' : 'Guest widget on iPhone Home Screen'}
          width={1600}
          class="w-full h-auto block pointer-events-none select-none"
          draggable={false}
        />
      </div>
    </section>

    <!-- Section 10: Privacy -->
    <section class="px-3.5 sm:px-6 md:px-10 pt-10 pb-20 md:pt-14 md:pb-28">
      <div class="max-w-[756px] mx-auto">
        <div class="max-w-[560px] mx-auto">
          <h2 class="text-[14px] 2xl:text-[15px] font-medium leading-[1.35]">
            {copy.s5Title}
          </h2>
          <div class="mt-5 md:mt-6 space-y-4 text-[14px] 2xl:text-[15px] leading-[1.55]">
            <p>{copy.s5Text}</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Part 4: Pure Black closing band — Full iOS Lock Screen + Closing note -->
  <div class="bg-black text-white">
    <!-- Section 11: Full Lock Screen on pure black -->
    <section class="px-3.5 sm:px-6 md:px-10 pt-8 pb-0">
      <div class="max-w-[756px] mx-auto">
        <Image
          src={GUEST_ASSETS.lockscreenFull}
          alt={lang === 'ru' ? 'Экран блокировки iPhone с уведомлением Guest' : 'Full iPhone Lock Screen with Guest notification'}
          width={1400}
          class="w-full h-auto block pointer-events-none select-none"
          draggable={false}
        />
      </div>
    </section>

    <!-- Section 12: Closing reflection + generous dark bottom breathing room -->
    <section class="px-3.5 sm:px-6 md:px-10 pt-6 pb-32 md:pt-8 md:pb-56">
      <div class="max-w-[756px] mx-auto">
        <div class="max-w-[560px] mx-auto space-y-4 text-[14px] 2xl:text-[15px] leading-[1.55]">
          <p>{copy.s6Text}</p>
        </div>
      </div>
    </section>
  </div>
</main>
