---
import { Image } from 'astro:assets';
import { GUEST_ASSETS, getNextProject, type ProjectItem } from '../data/projects';
import {
  UI,
  getGuestPrivacyPath,
  getProjectPath,
  type Lang,
} from '../i18n/ui';

interface Props {
  project: ProjectItem;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = UI[lang];
const nextProject = getNextProject(project.slug);
const nextHref = getProjectPath(lang, nextProject.slug);
const privacyHref = getGuestPrivacyPath(lang);

const copy = {
  en: {
    headline: 'Guest — One photographer every week',
    lead: 'This concept could have been built in many other ways — as a website, a newsletter, a web app, or a Telegram channel. Yet choosing a native iPhone app for Guest is intentional: here, content is inseparable from form, and the interface itself is part of\u00A0the\u00A0statement.',
    leadSub: 'Negative space, typography, tactile feedback, a pure white canvas, and the absence of visual noise make the project what it was meant to\u00A0be.',
    s1Title: 'Idea and Philosophy',
    s1Text: 'We live in endless feeds where photography is reduced to thumbnails competing for two seconds of attention. Guest slows the rhythm down to one name per week — giving each author space to stay with you without algorithms, likes, or infinite\u00A0scrolling.',
    s2Text: 'Once a week, on Sunday at 10:00, Guest sends a quiet notification. A new photographer arrives at midnight from Saturday to Sunday — a deliberate, predictable cadence instead of constant\u00A0urgency.',
    s3Title: 'Form',
    s3Text: 'Only the photographer’s name on a pure white screen, minimal settings, and haptic nuance. The app stays calm so the work and curiosity around the author become the entire\u00A0focus.',
    s6Title: 'Home Screen',
    s6Text: 'A quiet square widget keeps the current guest present on your iPhone Home Screen throughout the week — a subtle editorial reminder with zero\u00A0clutter.',
    s4Title: 'Who is the guest?',
    s4Text: 'Curated voices across contemporary fashion, documentary, and fine-art photography — each edition highlights one photographer whose visual language deserves unhurried\u00A0discovery.',
    s5Title: 'Privacy',
    s5Text: 'No accounts, no tracking pixels, no behavioral profiles, and no social noise. Guest does not collect personal analytics — it simply delivers one photographer every\u00A0week.',
  },
  ru: {
    headline: 'Guest — Один фотограф каждую неделю',
    lead: 'Эту идею можно было бы реализовать иначе — как сайт, рассылку, веб-приложение или канал в\u00A0Telegram. Но выбор нативного приложения для iPhone здесь принципиален: в\u00A0Guest форма неотделима от содержания, а\u00A0сам интерфейс является частью\u00A0высказывания.',
    leadSub: 'Негативное пространство, типографика, тактильный отклик, чистый белый лист и\u00A0отсутствие визуального шума делают проект именно таким, каким он\u00A0задумывался.',
    s1Title: 'Идея и\u00A0философия',
    s1Text: 'Бесконечные ленты превратили фотографию в\u00A0поток превью, которые борются за две секунды внимания. Guest замедляет ритм до одного имени в\u00A0неделю — оставляя место для спокойного знакомства без алгоритмов, лайков и\u00A0скролла.',
    s2Text: 'Раз в\u00A0неделю, в\u00A0воскресенье в\u00A010:00, приложение присылает одно спокойное уведомление. Новый герой обновляется в\u00A0полночь с\u00A0субботы на воскресенье — предсказуемый ритуал вместо информационного\u00A0шума.',
    s3Title: 'Форма',
    s3Text: 'На чистом белом экране — только имя фотографа, минимальные настройки и\u00A0тактильный отклик. Интерфейс намеренно уходит в\u00A0сторону, чтобы всё внимание оставалось на\u00A0авторе.',
    s6Title: 'Экран «Домой»',
    s6Text: 'Минималистичный квадратный виджет держит имя текущего фотографа на домашнем экране iPhone всю неделю — как тихое напоминание без визуальной\u00A0перегрузки.',
    s4Title: 'Кто гость?',
    s4Text: 'Кураторский выбор современных авторов из модной, документальной и\u00A0арт-фотографии — каждую неделю один фотограф, к\u00A0работам которого хочется вернуться без\u00A0спешки.',
    s5Title: 'Приватность',
    s5Text: 'Никакой регистрации, трекеров, профилирования и\u00A0скрытой аналитики. Приложение не собирает лишние данные и\u00A0решает одну простую\u00A0задачу.',
  },
}[lang];

const COL = 'w-full max-w-[640px] 2xl:max-w-[700px] mx-auto';
const FULL_PHONE = 'w-full max-w-[480px] 2xl:max-w-[540px] mx-auto';
---

<main
  data-guest-canvas
  class="relative flex-1 bg-white text-[#141414] text-[14px] md:text-[13px] 2xl:text-[15px] leading-[1.5] font-normal [&_p]:text-pretty"
>
  <section class="relative z-10 px-4 pt-[96px] md:pt-[var(--page-top-desktop)] pb-[calc(2.5rem+env(safe-area-inset-bottom))] md:pb-24">
    <div class={`${COL} flex flex-col gap-11 md:gap-15`}>
      <div>
        <h1 class="leading-[1.35]">
          {copy.headline}
        </h1>
        <p class="mt-0.5 leading-[1.35]">
          <span>{project.role[lang]}</span>
          {project.status && (
            <span class="block">{project.status[lang]}</span>
          )}
        </p>

        {project.appStoreUrl && (
          <div class="mt-4">
            <a
              href={project.appStoreUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block py-2 -my-2 md:py-0 md:my-0 underline underline-offset-4 hover:opacity-55 transition-opacity"
            >
              {t.downloadAppStore}
            </a>
          </div>
        )}

        <div class="mt-5 md:mt-6 space-y-3.5">
          <p>{copy.lead}</p>
          <p>{copy.leadSub}</p>
        </div>
      </div>

      <div class={FULL_PHONE}>
        <Image
          src={GUEST_ASSETS.hero}
          alt={lang === 'ru' ? 'Экран приложения Guest на iPhone с именем фотографа Greg Swales' : 'Guest iPhone app showing photographer Greg Swales'}
          width={1080}
          class="w-full h-auto block -mt-[7.2%] -mb-[6.67%] pointer-events-none select-none"
          loading="eager"
          draggable={false}
        />
      </div>

      <div data-reveal="text">
        <h2 class="leading-[1.35]">
          {copy.s3Title}
        </h2>
        <div class="mt-2 space-y-3.5">
          <p>{copy.s3Text}</p>
        </div>
      </div>

      <div data-reveal="media" class={FULL_PHONE}>
        <Image
          src={GUEST_ASSETS.settings}
          alt={lang === 'ru' ? 'Настройки еженедельного уведомления Guest' : 'Guest weekly notification settings'}
          width={1080}
          class="w-full h-auto block -mt-[7.2%] -mb-[6.67%] pointer-events-none select-none"
          draggable={false}
        />
      </div>

      <div data-reveal="text">
        <h2 class="leading-[1.35]">
          {copy.s1Title}
        </h2>
        <div class="mt-2 space-y-3.5">
          <p>{copy.s1Text}</p>
          <p>{copy.s2Text}</p>
        </div>
      </div>

      <div data-reveal="media" class="w-full mt-3 mb-1.5 md:mt-4 md:mb-2">
        <Image
          src={GUEST_ASSETS.lockscreen}
          alt={lang === 'ru' ? 'Уведомление Guest на экране блокировки iPhone' : 'Guest notification on iPhone Lock Screen'}
          width={1600}
          class="w-full h-auto block pointer-events-none select-none"
          draggable={false}
        />
      </div>

      <div data-reveal="text">
        <h2 class="leading-[1.35]">
          {copy.s6Title}
        </h2>
        <div class="mt-2 space-y-3.5">
          <p>{copy.s6Text}</p>
        </div>
      </div>

      <div data-reveal="media" class="w-full mt-1 mb-3 md:mt-1.5 md:mb-4">
        <Image
          src={GUEST_ASSETS.widget}
          alt={lang === 'ru' ? 'Виджет Guest на домашнем экране iPhone' : 'Guest widget on iPhone Home Screen'}
          width={1600}
          class="w-full h-auto block pointer-events-none select-none"
          draggable={false}
        />
      </div>

      <div data-reveal="text" class="space-y-6 md:space-y-7">
        <div>
          <h2 class="leading-[1.35]">
            {copy.s4Title}
          </h2>
          <div class="mt-2 space-y-3.5">
            <p>{copy.s4Text}</p>
          </div>
        </div>

        <div>
          <h2 class="leading-[1.35]">
            {copy.s5Title}
          </h2>
          <div class="mt-2 space-y-3.5">
            <p>{copy.s5Text}</p>
            <p>
              <a
                href={privacyHref}
                class="inline-block py-2 -my-2 md:py-0 md:my-0 underline underline-offset-4 hover:opacity-55 transition-opacity"
              >
                {t.privacyPolicy}
              </a>
            </p>
          </div>
        </div>
      </div>

      <div data-reveal="media" class={FULL_PHONE}>
        <Image
          src={GUEST_ASSETS.lockscreenFull}
          alt={lang === 'ru' ? 'Экран блокировки iPhone с уведомлением Guest' : 'Full iPhone Lock Screen with Guest notification'}
          width={1080}
          class="w-full h-auto block -mt-[7.2%] -mb-[6.67%] pointer-events-none select-none"
          draggable={false}
        />
      </div>

      <footer
        data-reveal="text"
        class="flex justify-end"
      >
        <a
          href={nextHref}
          class="inline-flex flex-col items-end text-right min-h-[44px] md:min-h-0 hover:opacity-55 transition-opacity focus:outline-none w-fit"
        >
          <span class="leading-[1.35]">{t.nextProject}</span>
          <span class="mt-0.5 leading-[1.35]">{nextProject.title[lang]}</span>
        </a>
      </footer>
    </div>
  </section>
</main>

<style>
  [data-guest-canvas][data-reveal-ready='true'] [data-reveal='text'] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 720ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  [data-guest-canvas][data-reveal-ready='true'] [data-reveal='media'] {
    opacity: 0;
    transform: translateY(28px) scale(0.985);
    transition:
      opacity 880ms cubic-bezier(0.22, 1, 0.36, 1) 80ms,
      transform 880ms cubic-bezier(0.22, 1, 0.36, 1) 80ms;
    will-change: opacity, transform;
  }

  [data-guest-canvas][data-reveal-ready='true'] [data-reveal][data-revealed='true'] {
    opacity: 1;
    transform: none;
    will-change: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-guest-canvas][data-reveal-ready='true'] [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLElement>('[data-guest-canvas]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && !prefersReducedMotion) {
    const revealTargets = Array.from(canvas.querySelectorAll<HTMLElement>('[data-reveal]'));
    const initialTriggerY = window.innerHeight * 0.94;

    for (const el of revealTargets) {
      if (el.getBoundingClientRect().top <= initialTriggerY) {
        el.dataset.revealed = 'true';
      }
    }

    canvas.dataset.revealReady = 'true';

    const pending = revealTargets.filter((el) => el.dataset.revealed !== 'true');
    if (pending.length > 0 && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting || entry.boundingClientRect.top < window.innerHeight * 0.92) {
              const target = entry.target as HTMLElement;
              target.dataset.revealed = 'true';
              observer.unobserve(target);
            }
          }
        },
        { threshold: 0.08, rootMargin: '0px 0px -8% 0px' }
      );

      for (const el of pending) {
        observer.observe(el);
      }
    } else {
      for (const el of pending) {
        el.dataset.revealed = 'true';
      }
    }
  }
</script>
