---
import { getAlternateLangPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className = '' } = Astro.props;
const pathname = Astro.url.pathname;
const enHref = getAlternateLangPath(pathname, 'en');
const ruHref = getAlternateLangPath(pathname, 'ru');
---

<div
  class:list={[
    'flex items-center gap-3 text-[14px] md:text-[13px] 2xl:text-[15px] leading-[1.25] tracking-normal tabular-nums',
    className,
  ]}
  aria-label="Language switcher"
>
  <a
    href={enHref}
    hreflang="en"
    aria-current={lang === 'en' ? 'true' : undefined}
    class:list={[
      'inline-flex items-center justify-center min-h-[40px] px-1.5 -mx-1.5 md:min-h-0 md:px-0 md:mx-0 md:py-0.5 text-[#141414] transition-opacity duration-150',
      lang === 'en' ? 'font-semibold' : 'font-normal hover:opacity-55',
    ]}
  >
    En
  </a>
  <a
    href={ruHref}
    hreflang="ru"
    aria-current={lang === 'ru' ? 'true' : undefined}
    class:list={[
      'inline-flex items-center justify-center min-h-[40px] px-1.5 -mx-1.5 md:min-h-0 md:px-0 md:mx-0 md:py-0.5 text-[#141414] transition-opacity duration-150',
      lang === 'ru' ? 'font-semibold' : 'font-normal hover:opacity-55',
    ]}
  >
    Ru
  </a>
</div>
