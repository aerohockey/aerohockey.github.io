---
import { getAlternateLangPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className = '' } = Astro.props;
const pathname = Astro.url.pathname;
const enHref = getAlternateLangPath(pathname, 'en');
const ruHref = getAlternateLangPath(pathname, 'ru');
---

<div
  class:list={[
    'flex items-center gap-2.5 md:gap-3 text-[14px] leading-[1.25] tracking-normal tabular-nums',
    className,
  ]}
  aria-label="Language switcher"
>
  <a
    href={enHref}
    hreflang="en"
    aria-current={lang === 'en' ? 'true' : undefined}
    class:list={[
      'py-0.5 text-[#141414] transition-opacity duration-150',
      lang === 'en' ? 'font-bold' : 'font-normal hover:opacity-55',
    ]}
  >
    En
  </a>
  <a
    href={ruHref}
    hreflang="ru"
    aria-current={lang === 'ru' ? 'true' : undefined}
    class:list={[
      'py-0.5 text-[#141414] transition-opacity duration-150',
      lang === 'ru' ? 'font-bold' : 'font-normal hover:opacity-55',
    ]}
  >
    Ru
  </a>
</div>
