---
import ResponsiveImage from './ResponsiveImage.astro';
import type { Lang } from '../i18n/ui';
import type { CmsMediaAsset } from '../lib/content';
import { getPosterUrl } from '../lib/sanity';

interface Props {
  media: CmsMediaAsset;
  lang: Lang;
  width?: number;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  media,
  lang,
  width = 1600,
  loading = 'lazy',
  class: className = '',
} = Astro.props;
---

{
  media.type === 'video' ? (
    <video
      src={media.src}
      poster={getPosterUrl(media.poster)}
      aria-label={media.alt[lang]}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      class:list={['w-full h-full object-cover block select-none', className]}
    />
  ) : (
    <ResponsiveImage
      image={media.image}
      alt={media.alt[lang]}
      width={width}
      class={['w-full h-full object-cover pointer-events-none select-none', className].filter(Boolean).join(' ')}
      loading={loading}
      draggable={false}
    />
  )
}
