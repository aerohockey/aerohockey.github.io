---
import { Image } from 'astro:assets';
import type { MediaAsset } from '../data/projects';
import type { Lang } from '../i18n/ui';

interface Props {
  media: MediaAsset;
  lang: Lang;
  width?: number;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  media,
  lang,
  width = 1600,
  loading = 'lazy',
  class: className = '',
} = Astro.props;
---

{
  media.type === 'video' ? (
    <video
      src={media.src}
      poster={media.poster?.src}
      aria-label={media.alt[lang]}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      class:list={['w-full h-full object-cover block select-none', className]}
    />
  ) : (
    <Image
      src={media.image}
      alt={media.alt[lang]}
      width={width}
      class:list={['w-full h-full object-cover pointer-events-none select-none', className]}
      loading={loading}
      draggable={false}
    />
  )
}
