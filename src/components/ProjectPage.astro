---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingProjectView from './LandingProjectView.astro';
import GalleryProjectView from './GalleryProjectView.astro';
import type { CmsProject } from '../lib/content';
import { getSiteSettings } from '../lib/content';
import type { Lang } from '../i18n/ui';

interface Props {
  project: CmsProject;
  lang: Lang;
}

const { project, lang } = Astro.props;
const settings = await getSiteSettings();
const isGallery = project.format === 'gallery';
---

<BaseLayout
  title={`${project.title[lang]} — ${settings.brand[lang]}`}
  description={project.intro?.[lang] ?? project.subtitle[lang]}
  lang={lang}
  activeNav="work"
  desktopLockViewport={isGallery}
  ogImage={project.cover}
>
  {isGallery ? (
    <GalleryProjectView project={project} lang={lang} />
  ) : (
    <LandingProjectView project={project} lang={lang} />
  )}
</BaseLayout>
