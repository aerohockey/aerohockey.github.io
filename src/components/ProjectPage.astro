---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingProjectView from './LandingProjectView.astro';
import GalleryProjectView from './GalleryProjectView.astro';
import type { ProjectItem } from '../data/projects';
import { UI, type Lang } from '../i18n/ui';

interface Props {
  project: ProjectItem;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = UI[lang];
const isGallery = project.format === 'gallery';
---

<BaseLayout
  title={`${project.title[lang]} — ${t.brand}`}
  description={project.subtitle[lang]}
  lang={lang}
  lockViewport={isGallery}
  autoHideHeader={!isGallery}
>
  {isGallery ? (
    <GalleryProjectView project={project} lang={lang} />
  ) : (
    <LandingProjectView project={project} lang={lang} />
  )}
</BaseLayout>
