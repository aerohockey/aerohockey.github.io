---
import { getProjectPath, type Lang } from '../i18n/ui';
import { getGuestPrivacy } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const privacy = await getGuestPrivacy();
const guestHref = getProjectPath(lang, 'guest');
---

<main class="flex-1 bg-white text-[#141414] pt-[96px] md:pt-36 pb-[calc(3rem+env(safe-area-inset-bottom))] px-4 text-[14px] md:text-[13px] 2xl:text-[15px] leading-[1.5] font-normal">
  <div class="max-w-[560px] md:ml-[24%]">
    <a
      href={guestHref}
      class="inline-flex items-center min-h-[40px] md:min-h-0 hover:opacity-55 transition-opacity"
    >
      ← {privacy.backLabel[lang]}
    </a>

    <h1 class="mt-4 leading-[1.35]">
      {privacy.title[lang]}
    </h1>
    <p class="mt-0.5 leading-[1.35]">{privacy.updated[lang]}</p>

    <p class="mt-6">
      {privacy.intro[lang]}
    </p>

    <div class="mt-8 space-y-6">
      {privacy.sections.map((section) => (
        <section>
          <h2 class="leading-[1.35]">
            {section.heading[lang]}
          </h2>
          <p class="mt-1.5">
            {section.text[lang]}
            {section.appendContactEmail && (
              <a
                href={`mailto:${privacy.contactEmail}`}
                class="underline underline-offset-4 hover:opacity-55 transition-opacity"
              >
                {privacy.contactEmail}
              </a>
            )}
          </p>
        </section>
      ))}
    </div>
  </div>
</main>
