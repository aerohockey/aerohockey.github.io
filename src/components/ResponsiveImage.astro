---
import { Image } from 'astro:assets';
import {
  getSanityImageUrl,
  getSanitySrcSet,
  type ResolvedImage,
} from '../lib/sanity';

interface Props {
  image: ResolvedImage;
  alt: string;
  width?: number;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
  draggable?: boolean;
}

const {
  image,
  alt,
  width = 1600,
  sizes = '(max-width: 767px) 100vw, 1200px',
  loading = 'lazy',
  class: className = '',
  draggable = false,
} = Astro.props;
---

{
  image.kind === 'local' ? (
    <Image
      src={image.asset}
      alt={alt}
      width={width}
      class={className}
      loading={loading}
      draggable={draggable}
    />
  ) : (
    <img
      src={getSanityImageUrl(image, Math.min(width, image.width))}
      srcset={getSanitySrcSet(image)}
      sizes={sizes}
      alt={alt}
      width={image.width}
      height={image.height}
      style={image.objectPosition ? `object-position: ${image.objectPosition}` : undefined}
      class={className}
      loading={loading}
      decoding="async"
      draggable={draggable}
    />
  )
}
