---
import LangSwitch from './LangSwitch.astro';
import { getCoverDesktopScales } from '../data/projects';
import {
  UI,
  getHomePath,
  getInfoPath,
  type Lang,
} from '../i18n/ui';
import { getProjects, getSiteSettings } from '../lib/content';

interface Props {
  lang: Lang;
  activeNav?: 'work' | 'info';
  autoHide?: boolean;
}

const {
  lang,
  activeNav,
  autoHide = false,
} = Astro.props;
const t = UI[lang];
const [projects, settings] = await Promise.all([getProjects(), getSiteSettings()]);
const homeHref = getHomePath(lang);
const infoHref = getInfoPath(lang);
const firstCardWidthScale = getCoverDesktopScales(
  projects[0]?.coverAspect ?? '1/1'
).widthScale;
---

<header
  data-auto-hide={autoHide ? 'true' : undefined}
  class:list={[
    'fixed top-0 left-0 w-full md:w-[100vw] z-40 bg-white/95 backdrop-blur-sm px-4 pt-1 pb-1 md:pt-2 md:pb-3',
    autoHide && 'will-change-transform',
  ]}
>
  <div class="flex items-center justify-between md:justify-start gap-x-2 md:gap-0 text-[14px] md:text-[13px] 2xl:text-[15px] leading-[1.25] tracking-normal">
    <!-- Brand -->
    <div
      style={`--first-w: ${firstCardWidthScale};`}
      class="shrink-0 header-brand-desktop"
    >
      <a
        href={homeHref}
        class="inline-flex items-center min-h-[40px] px-1.5 -mx-1.5 md:min-h-0 md:px-0 md:mx-0 md:py-0.5 text-[#141414] hover:opacity-55 transition-opacity duration-200 whitespace-nowrap"
      >
        {settings.brand[lang]}
      </a>
    </div>

    <!-- Navigation: same row centered between brand & lang on mobile; aligned on desktop -->
    <nav
      aria-label="Main navigation"
      class="flex items-center shrink-0 gap-x-3.5 md:gap-x-5 md:flex-1 md:justify-start min-w-0"
    >
      <a
        href={homeHref}
        aria-current={activeNav === 'work' ? 'page' : undefined}
        class:list={[
          'inline-flex items-center min-h-[40px] px-1.5 -mx-1.5 md:min-h-0 md:px-0 md:mx-0 md:py-0.5 text-[#141414] transition-opacity duration-150 whitespace-nowrap',
          activeNav === 'work' ? 'font-semibold' : 'font-normal hover:opacity-55',
        ]}
      >
        {t.work}
      </a>
      <a
        href={infoHref}
        aria-current={activeNav === 'info' ? 'page' : undefined}
        class:list={[
          'inline-flex items-center min-h-[40px] px-1.5 -mx-1.5 md:min-h-0 md:px-0 md:mx-0 md:py-0.5 text-[#141414] transition-opacity duration-150 whitespace-nowrap',
          activeNav === 'info' ? 'font-semibold' : 'font-normal hover:opacity-55',
        ]}
      >
        {t.info}
      </a>
    </nav>

    <!-- Language switcher -->
    <div class="shrink-0 md:flex md:justify-end md:w-auto">
      <LangSwitch lang={lang} />
    </div>
  </div>
</header>

<style>
  @media (min-width: 768px) {
    .header-brand-desktop {
      width: calc(var(--rail-h-desktop) * var(--first-w) + 1.5rem);
    }
  }

  header[data-auto-hide='true'] {
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  header[data-auto-hide='true'][data-hidden='true'] {
    transform: translateY(-100%);
    pointer-events: none;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('header[data-auto-hide="true"]');
  if (header) {
    const TOP_SAFE_ZONE = 80;
    const DELTA_THRESHOLD = 10;
    let lastY = Math.max(window.scrollY, 0);
    let hidden = false;
    let ticking = false;

    const setHidden = (next: boolean) => {
      if (next === hidden) return;
      hidden = next;
      header.dataset.hidden = next ? 'true' : 'false';
    };

    const update = () => {
      ticking = false;
      const currentY = Math.max(window.scrollY, 0);
      const docHeight = document.documentElement.scrollHeight;
      const atBottom = currentY + window.innerHeight >= docHeight - 4;

      if (currentY <= TOP_SAFE_ZONE || header.contains(document.activeElement)) {
        setHidden(false);
        lastY = currentY;
        return;
      }

      const delta = currentY - lastY;
      if (Math.abs(delta) < DELTA_THRESHOLD) return;

      if (delta > 0) {
        setHidden(true);
      } else if (!atBottom) {
        setHidden(false);
      }

      lastY = currentY;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(update);
        }
      },
      { passive: true }
    );

    header.addEventListener('focusin', () => setHidden(false));
  }
</script>
