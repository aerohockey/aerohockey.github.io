---
import LangSwitch from './LangSwitch.astro';
import {
  UI,
  getAboutPath,
  getContactPath,
  getHomePath,
  type Lang,
} from '../i18n/ui';

interface Props {
  lang: Lang;
  activeNav?: 'work' | 'about' | 'contact';
}

const { lang, activeNav } = Astro.props;
const t = UI[lang];
const homeHref = getHomePath(lang);
const aboutHref = getAboutPath(lang);
const contactHref = getContactPath(lang);
---

<header
  class="fixed top-0 inset-x-0 z-40 bg-white/95 backdrop-blur-sm px-5 md:px-10 py-3.5 md:py-4"
>
  <div class="flex items-start md:items-center justify-between gap-4 text-[11px] sm:text-[12px] leading-[1.15] tracking-[0.04em] md:tracking-[0.05em] uppercase">
    <!-- Brand (top-left) -->
    <div class="shrink-0 md:w-[24%]">
      <a
        href={homeHref}
        class="inline-block py-0.5 text-[#141414] hover:opacity-55 transition-opacity duration-200 whitespace-nowrap"
      >
        {t.brand}
      </a>
    </div>

    <!-- Navigation (top-right on mobile, middle on md+) -->
    <nav
      aria-label="Main navigation"
      class="flex flex-wrap items-center justify-end md:justify-start gap-x-3 sm:gap-x-4 md:gap-7 gap-y-1.5 md:flex-1 md:order-2"
    >
      <a
        href={homeHref}
        class:list={[
          'px-1.5 py-0.5 -mx-1.5 transition-colors duration-150 whitespace-nowrap',
          activeNav === 'work'
            ? 'bg-[#141414] text-white'
            : 'text-[#141414] hover:opacity-55',
        ]}
      >
        {t.work}
      </a>
      <a
        href={aboutHref}
        class:list={[
          'px-1.5 py-0.5 -mx-1.5 transition-colors duration-150 whitespace-nowrap',
          activeNav === 'about'
            ? 'bg-[#141414] text-white'
            : 'text-[#141414] hover:opacity-55',
        ]}
      >
        {t.about}
      </a>
      <a
        href={contactHref}
        class:list={[
          'px-1.5 py-0.5 -mx-1.5 transition-colors duration-150 whitespace-nowrap',
          activeNav === 'contact'
            ? 'bg-[#141414] text-white'
            : 'text-[#141414] hover:opacity-55',
        ]}
      >
        {t.contact}
      </a>
    </nav>

    <!-- Desktop Language switcher -->
    <div class="hidden md:flex items-center md:order-3 md:justify-end md:w-[24%]">
      <LangSwitch lang={lang} />
    </div>
  </div>
</header>
