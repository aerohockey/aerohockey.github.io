---
import LangSwitch from './LangSwitch.astro';
import {
  UI,
  getAboutPath,
  getContactPath,
  getHomePath,
  type Lang,
} from '../i18n/ui';

interface Props {
  lang: Lang;
  activeNav?: 'work' | 'about' | 'contact';
}

const { lang, activeNav } = Astro.props;
const t = UI[lang];
const homeHref = getHomePath(lang);
const aboutHref = getAboutPath(lang);
const contactHref = getContactPath(lang);
---

<header
  class="fixed top-0 inset-x-0 z-40 bg-white/95 backdrop-blur-sm px-3.5 sm:px-5 md:px-10 py-3.5 md:py-4"
>
  <div class="flex items-center justify-between gap-1 sm:gap-3 md:gap-0 text-[12px] md:text-[14px] leading-[1.25] tracking-normal">
    <!-- Brand -->
    <div class="shrink-0 md:w-[24%]">
      <a
        href={homeHref}
        class="inline-block py-0.5 text-[#141414] hover:opacity-55 transition-opacity duration-200 whitespace-nowrap"
      >
        {t.brand}
      </a>
    </div>

    <!-- Navigation: centered evenly between Brand & LangSwitch on mobile; offset column on desktop -->
    <nav
      aria-label="Main navigation"
      class="flex flex-wrap items-center justify-center md:justify-start gap-x-2.5 sm:gap-x-3.5 md:gap-x-5 gap-y-1 md:flex-1 min-w-0"
    >
      <a
        href={homeHref}
        aria-current={activeNav === 'work' ? 'page' : undefined}
        class:list={[
          'py-0.5 text-[#141414] transition-opacity duration-150 whitespace-nowrap',
          activeNav === 'work' ? 'font-semibold' : 'font-normal hover:opacity-55',
        ]}
      >
        {t.work}
      </a>
      <a
        href={aboutHref}
        aria-current={activeNav === 'about' ? 'page' : undefined}
        class:list={[
          'py-0.5 text-[#141414] transition-opacity duration-150 whitespace-nowrap',
          activeNav === 'about' ? 'font-semibold' : 'font-normal hover:opacity-55',
        ]}
      >
        {t.about}
      </a>
      <a
        href={contactHref}
        aria-current={activeNav === 'contact' ? 'page' : undefined}
        class:list={[
          'py-0.5 text-[#141414] transition-opacity duration-150 whitespace-nowrap',
          activeNav === 'contact' ? 'font-semibold' : 'font-normal hover:opacity-55',
        ]}
      >
        {t.contact}
      </a>
    </nav>

    <!-- Language switcher -->
    <div class="shrink-0 md:w-[24%] md:flex md:justify-end">
      <LangSwitch lang={lang} />
    </div>
  </div>
</header>
