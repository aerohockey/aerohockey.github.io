---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const content = {
  en: {
    srTitle: 'Contact',
    emailLabel: 'Email',
    telegramLabel: 'Telegram',
    phoneLabel: 'Phone',
  },
  ru: {
    srTitle: 'Контакты',
    emailLabel: 'Почта',
    telegramLabel: 'Telegram',
    phoneLabel: 'Телефон',
  },
}[lang];
---

<main class="flex-1 min-h-0 overflow-y-auto flex flex-col pt-14 md:pt-16 pb-[calc(0.875rem+env(safe-area-inset-bottom))] md:pb-10 px-3.5 sm:px-6 md:px-10">
  <div class="contact-rail mt-auto w-full flex flex-col items-start">
    <h1 class="sr-only">{content.srTitle}</h1>

    <dl class="space-y-2 text-[14px] md:text-[15px] leading-[1.45]">
      <div class="flex items-baseline gap-3 md:gap-4">
        <dt class="shrink-0 w-[82px] md:w-[92px] text-[#141414]">
          {content.emailLabel}
        </dt>
        <dd class="min-w-0">
          <a
            href="mailto:hello@evgeny.studio"
            class="text-[#141414] hover:opacity-55 transition-opacity"
          >
            hello@evgeny.studio
          </a>
        </dd>
      </div>

      <div class="flex items-baseline gap-3 md:gap-4">
        <dt class="shrink-0 w-[82px] md:w-[92px] text-[#141414]">
          {content.telegramLabel}
        </dt>
        <dd class="min-w-0">
          <a
            href="https://t.me/aerohockey"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#141414] hover:opacity-55 transition-opacity"
          >
            @aerohockey
          </a>
        </dd>
      </div>

      <div class="flex items-baseline gap-3 md:gap-4">
        <dt class="shrink-0 w-[82px] md:w-[92px] text-[#141414]">
          {content.phoneLabel}
        </dt>
        <dd class="min-w-0">
          <a
            href="tel:+79992152027"
            class="text-[#141414] hover:opacity-55 transition-opacity tabular-nums"
          >
            +7 999 215 2027
          </a>
        </dd>
      </div>
    </dl>
  </div>
</main>

<style>
  .contact-rail {
    --rail-h: min(calc((100vw - 48px) * 4 / 3), var(--rail-vh));
    min-height: calc(var(--rail-h) + var(--caption-h));
  }

  @media (min-width: 640px) {
    .contact-rail {
      --rail-h: min(calc((100vw - 72px) * 4 / 3), var(--rail-vh));
    }
  }

  @media (min-width: 768px) {
    .contact-rail {
      --rail-h: min(calc(40vw * 5 / 4), var(--rail-svh));
    }
  }

  @media (min-width: 1024px) {
    .contact-rail {
      --rail-h: min(calc(33vw * 5 / 4), 625px, var(--rail-svh));
    }
  }
</style>
