---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const content = {
  en: {
    srTitle: 'Contact',
    emailLabel: 'Email',
    telegramLabel: 'Telegram',
    phoneLabel: 'Phone',
  },
  ru: {
    srTitle: 'Контакты',
    emailLabel: 'Почта',
    telegramLabel: 'Telegram',
    phoneLabel: 'Телефон',
  },
}[lang];
---

<main class="flex-1 min-h-0 overflow-y-auto flex flex-col justify-end pt-14 md:pt-16 pb-[calc(0.875rem+env(safe-area-inset-bottom))] md:pb-10 px-3.5 sm:px-6 md:px-10">
  <div class="contact-rail w-full flex flex-col items-start">
    <h1 class="sr-only">{content.srTitle}</h1>

    <dl class="w-full space-y-2">
      <div class="flex items-baseline gap-4 md:gap-0">
        <dt class="shrink-0 w-[76px] sm:w-[96px] md:w-[24%] text-[12px] sm:text-[13px] leading-[1.4] text-[#737373]">
          {content.emailLabel}
        </dt>
        <dd class="min-w-0 text-[15px] sm:text-[16px] leading-[1.4]">
          <a
            href="mailto:hello@evgeny.studio"
            class="text-[#141414] hover:opacity-55 transition-opacity"
          >
            hello@evgeny.studio
          </a>
        </dd>
      </div>

      <div class="flex items-baseline gap-4 md:gap-0">
        <dt class="shrink-0 w-[76px] sm:w-[96px] md:w-[24%] text-[12px] sm:text-[13px] leading-[1.4] text-[#737373]">
          {content.telegramLabel}
        </dt>
        <dd class="min-w-0 text-[15px] sm:text-[16px] leading-[1.4]">
          <a
            href="https://t.me/aerohockey"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#141414] hover:opacity-55 transition-opacity"
          >
            @aerohockey
          </a>
        </dd>
      </div>

      <div class="flex items-baseline gap-4 md:gap-0">
        <dt class="shrink-0 w-[76px] sm:w-[96px] md:w-[24%] text-[12px] sm:text-[13px] leading-[1.4] text-[#737373]">
          {content.phoneLabel}
        </dt>
        <dd class="min-w-0 text-[15px] sm:text-[16px] leading-[1.4]">
          <a
            href="tel:+79992152027"
            class="text-[#141414] hover:opacity-55 transition-opacity tabular-nums"
          >
            +7 999 215 2027
          </a>
        </dd>
      </div>
    </dl>
  </div>
</main>

<style>
  .contact-rail {
    --rail-h: min(calc((100vw - 48px) * 4 / 3), 74dvh);
    min-height: var(--rail-h);
  }

  @media (min-width: 640px) {
    .contact-rail {
      --rail-h: min(calc((100vw - 72px) * 4 / 3), 74dvh);
    }
  }

  @media (min-width: 768px) {
    .contact-rail {
      --rail-h: min(calc(40vw * 5 / 4), 66svh);
    }
  }

  @media (min-width: 1024px) {
    .contact-rail {
      --rail-h: min(calc(33vw * 5 / 4), 625px, 66svh);
    }
  }
</style>
