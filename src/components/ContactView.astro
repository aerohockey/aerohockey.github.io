---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const content = {
  en: {
    srTitle: 'Contact',
    emailLabel: 'Email',
    telegramLabel: 'Telegram',
    phoneLabel: 'Phone',
    copyLabel: 'Copy',
    copiedLabel: 'Copied',
  },
  ru: {
    srTitle: 'Контакты',
    emailLabel: 'Почта',
    telegramLabel: 'Telegram',
    phoneLabel: 'Телефон',
    copyLabel: 'Скопировать',
    copiedLabel: 'Скопировано',
  },
}[lang];
---

<main class="flex-1 min-h-0 overflow-y-auto flex flex-col justify-end pt-14 md:pt-16 pb-[calc(0.875rem+env(safe-area-inset-bottom))] md:pb-10 px-3.5 sm:px-6 md:px-10">
  <div class="contact-rail w-full flex flex-col items-start">
    <h1 class="sr-only">{content.srTitle}</h1>

    <dl class="w-full space-y-4 sm:space-y-5">
      <div class="flex items-baseline gap-4 md:gap-0">
        <dt class="shrink-0 w-[76px] sm:w-[96px] md:w-[24%] text-[12px] sm:text-[13px] text-[#737373]">
          {content.emailLabel}
        </dt>
        <dd class="min-w-0 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-[15px] sm:text-[16px]">
          <a
            href="mailto:hello@evgeny.studio"
            class="text-[#141414] hover:opacity-55 transition-opacity"
          >
            hello@evgeny.studio
          </a>
          <button
            type="button"
            data-copy="hello@evgeny.studio"
            data-label={content.copyLabel}
            data-copied={content.copiedLabel}
            class="text-[11px] sm:text-[12px] text-[#737373] hover:text-[#141414] transition-colors cursor-pointer"
          >
            {content.copyLabel}
          </button>
        </dd>
      </div>

      <div class="flex items-baseline gap-4 md:gap-0">
        <dt class="shrink-0 w-[76px] sm:w-[96px] md:w-[24%] text-[12px] sm:text-[13px] text-[#737373]">
          {content.telegramLabel}
        </dt>
        <dd class="min-w-0 text-[15px] sm:text-[16px]">
          <a
            href="https://t.me/aerohockey"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#141414] hover:opacity-55 transition-opacity"
          >
            @aerohockey
          </a>
        </dd>
      </div>

      <div class="flex items-baseline gap-4 md:gap-0">
        <dt class="shrink-0 w-[76px] sm:w-[96px] md:w-[24%] text-[12px] sm:text-[13px] text-[#737373]">
          {content.phoneLabel}
        </dt>
        <dd class="min-w-0 text-[15px] sm:text-[16px]">
          <a
            href="tel:+79992152027"
            class="text-[#141414] hover:opacity-55 transition-opacity tabular-nums"
          >
            +7 999 215 2027
          </a>
        </dd>
      </div>
    </dl>
  </div>
</main>

<style>
  .contact-rail {
    --rail-h: min(calc((100vw - 48px) * 4 / 3), 74dvh);
    min-height: var(--rail-h);
  }

  @media (min-width: 640px) {
    .contact-rail {
      --rail-h: min(calc((100vw - 72px) * 4 / 3), 74dvh);
    }
  }

  @media (min-width: 768px) {
    .contact-rail {
      --rail-h: min(calc(40vw * 5 / 4), 66svh);
    }
  }

  @media (min-width: 1024px) {
    .contact-rail {
      --rail-h: min(calc(33vw * 5 / 4), 625px, 66svh);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy;
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        const orig = btn.dataset.label ?? 'Copy';
        btn.textContent = btn.dataset.copied ?? 'Copied';
        setTimeout(() => {
          btn.textContent = orig;
        }, 1600);
      } catch {
        // Ignore clipboard errors in restricted contexts
      }
    });
  });
</script>
