---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const content = {
  en: {
    eyebrow: 'Contact',
    headline: 'Let’s work together.',
    lead: 'The fastest way to reach me is Telegram. You can also write by email or call:',
    telegramLabel: 'Telegram',
    emailLabel: 'Email',
    phoneLabel: 'Phone',
    copyLabel: 'Copy',
    copiedLabel: 'Copied',
  },
  ru: {
    eyebrow: 'Контакты',
    headline: 'Открыт к проектам и съёмкам.',
    lead: 'Проще всего написать мне в Telegram. Также можно связаться по почте или телефону:',
    telegramLabel: 'Telegram',
    emailLabel: 'Почта',
    phoneLabel: 'Телефон',
    copyLabel: 'Скопировать',
    copiedLabel: 'Скопировано',
  },
}[lang];
---

<main class="flex-1 px-5 md:px-10 pt-28 md:pt-32 pb-20 max-w-[1440px] w-full mx-auto">
  <div class="max-w-[680px] lg:ml-[8.333%] space-y-10">
    <div class="space-y-4">
      <p class="text-[11px] uppercase tracking-[0.08em] text-[#737373]">
        {content.eyebrow}
      </p>
      <h1 class="text-[28px] sm:text-[34px] md:text-[38px] font-normal leading-[1.14] tracking-[-0.015em] text-[#141414]">
        {content.headline}
      </h1>
      <p class="text-[16px] leading-[1.6] text-[#525252] max-w-[48ch]">
        {content.lead}
      </p>
    </div>

    <dl class="divide-y divide-black/10 border-y border-black/10 text-[15px] sm:text-[16px]">
      <div class="py-4 flex items-center justify-between gap-4">
        <dt class="text-[12px] uppercase tracking-[0.05em] text-[#737373]">
          {content.telegramLabel}
        </dt>
        <dd>
          <a
            href="https://t.me/aerohockey"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#141414] hover:opacity-55 transition-opacity underline underline-offset-4 decoration-1"
          >
            @aerohockey
          </a>
        </dd>
      </div>

      <div class="py-4 flex items-center justify-between gap-4">
        <dt class="text-[12px] uppercase tracking-[0.05em] text-[#737373]">
          {content.emailLabel}
        </dt>
        <dd class="flex items-center gap-3">
          <a
            href="mailto:hello@evgeny.studio"
            class="text-[#141414] hover:opacity-55 transition-opacity underline underline-offset-4 decoration-1"
          >
            hello@evgeny.studio
          </a>
          <button
            type="button"
            data-copy="hello@evgeny.studio"
            data-label={content.copyLabel}
            data-copied={content.copiedLabel}
            class="text-[11px] uppercase tracking-[0.05em] px-2 py-0.5 border border-black/15 text-[#737373] hover:text-[#141414] hover:border-black/40 transition-colors cursor-pointer"
          >
            {content.copyLabel}
          </button>
        </dd>
      </div>

      <div class="py-4 flex items-center justify-between gap-4">
        <dt class="text-[12px] uppercase tracking-[0.05em] text-[#737373]">
          {content.phoneLabel}
        </dt>
        <dd>
          <a
            href="tel:+79992152027"
            class="text-[#141414] hover:opacity-55 transition-opacity tabular-nums"
          >
            +7 999 215 2027
          </a>
        </dd>
      </div>
    </dl>
  </div>
</main>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy;
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        const orig = btn.dataset.label ?? 'Copy';
        btn.textContent = btn.dataset.copied ?? 'Copied';
        setTimeout(() => {
          btn.textContent = orig;
        }, 1600);
      } catch {
        // Ignore clipboard errors in restricted contexts
      }
    });
  });
</script>
