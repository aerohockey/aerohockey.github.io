---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { getAlternateLangPath, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  activeNav?: 'work' | 'about' | 'contact';
  lockViewport?: boolean;
  autoHideHeader?: boolean;
}

const {
  title,
  description = '',
  lang,
  activeNav,
  lockViewport = false,
  autoHideHeader = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const enPath = getAlternateLangPath(pathname, 'en');
const ruPath = getAlternateLangPath(pathname, 'ru');
---

<!doctype html>
<html lang={lang} class={lockViewport ? 'h-full overflow-hidden' : ''}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="alternate" hreflang="en" href={enPath} />
    <link rel="alternate" hreflang="ru" href={ruPath} />
    <title>{title}</title>
  </head>
  <body
    class:list={[
      'bg-white text-[#141414] font-sans antialiased',
      lockViewport ? 'h-full min-h-0 overflow-hidden flex flex-col' : 'min-h-screen flex flex-col',
    ]}
  >
    <Header lang={lang} activeNav={activeNav} autoHide={autoHideHeader} />
    <slot />
  </body>
</html>
